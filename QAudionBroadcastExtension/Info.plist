<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Q-Audion Screen Share</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Must match the parent app's CFBundleVersion/CFBundleShortVersionString
	     (same Apple validation rule as QAudionPacketTunnel/Info.plist).
	     Placeholder here in git; ios-testflight.yml's "Set up signing" /
	     version-bump step must be EXTENDED to plutil-replace this file too
	     (mirroring the existing EXT_PLIST="../QAudionPacketTunnel/Info.plist"
	     block); NOT yet wired, tracked for the next stage. -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.791</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- LiveKit screen-share IPC: BroadcastBundleInfo.groupIdentifier reads
	     Bundle.main.infoDictionary["RTCAppGroupIdentifier"], and this
	     PROCESS's Bundle.main is the extension bundle, not the host app's.
	     Must be the SAME value as QAudionApp/Info.plist's RTCAppGroupIdentifier
	     or LKSampleHandler (this side) and BroadcastScreenCapturer (app side)
	     derive different socket paths and IPC never connects. See
	     client-sdk-swift Sources/LiveKit/Broadcast/BroadcastBundleInfo.swift. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.bcrypto.qaudion.broadcast</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.broadcast-services-upload</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).SampleHandler</string>
		<key>RPBroadcastProcessMode</key>
		<string>RPBroadcastProcessModeSampleBuffer</string>
	</dict>
</dict>
</plist>
