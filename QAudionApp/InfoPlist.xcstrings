{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "comment": "Microphone access: calls, voice messages, voice auth",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses your microphone for end-to-end encrypted voice and video calls, for voice messages in chats, and for voice authentication."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa il microfono per le chiamate vocali e video cifrate end-to-end, per i messaggi vocali nelle chat e per l'autenticazione vocale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa el micrófono para llamadas de voz y vídeo cifradas de extremo a extremo, para mensajes de voz en los chats y para la autenticación por voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le microphone pour les appels vocaux et vidéo chiffrés de bout en bout, pour les messages vocaux dans les discussions et pour l'authentification vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet das Mikrofon für Ende-zu-Ende-verschlüsselte Sprach- und Videoanrufe, für Sprachnachrichten in Chats und für die Sprachauthentifizierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa o microfone para chamadas de voz e vídeo com criptografia de ponta a ponta, para mensagens de voz nas conversas e para autenticação por voz."
          }
        }
      }
    },
    "NFCReaderUsageDescription": {
      "extractionState": "manual",
      "comment": "NFC: in-person contact pairing with an Android phone",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa l'NFC solo quando associ di persona un contatto: avvicini l'iPhone al suo telefono Android con Q-Audion e i due telefoni ricavano insieme una chiave condivisa che confronti con un codice a 6 cifre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses NFC only when you pair a contact in person: you hold your iPhone against their Android phone running Q-Audion, and the two phones together derive a shared key that you compare using a 6-digit code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa NFC solo cuando emparejas a un contacto en persona: acercas tu iPhone a su teléfono Android con Q-Audion y los dos teléfonos obtienen juntos una clave compartida que comparas con un código de 6 dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le NFC uniquement lorsque vous associez un contact en personne : vous approchez votre iPhone de son téléphone Android avec Q-Audion, et les deux téléphones calculent ensemble une clé partagée que vous comparez à l'aide d'un code à 6 chiffres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet NFC nur, wenn Sie einen Kontakt persönlich koppeln: Sie halten Ihr iPhone an sein Android-Telefon mit Q-Audion, und beide Telefone leiten gemeinsam einen gemeinsamen Schlüssel ab, den Sie anhand eines 6-stelligen Codes vergleichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa NFC somente quando você pareia um contato pessoalmente: você aproxima seu iPhone do telefone Android dele com o Q-Audion, e os dois telefones geram juntos uma chave compartilhada que você compara com um código de 6 dígitos."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "comment": "Camera: video calls, chat photos/avatar, QR pairing",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses the camera for end-to-end encrypted video calls, to take photos you send in chats or set as your avatar, and to scan QR codes when pairing contacts or importing keys."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa la fotocamera per le videochiamate cifrate end-to-end, per scattare foto da inviare in chat o impostare come immagine del profilo, e per scansionare i codici QR durante l'associazione dei contatti o l'importazione delle chiavi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa la cámara para las videollamadas cifradas de extremo a extremo, para tomar fotos que envías en los chats o que estableces como tu avatar, y para escanear códigos QR al vincular contactos o importar claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise l'appareil photo pour les appels vidéo chiffrés de bout en bout, pour prendre des photos que vous envoyez dans les discussions ou définissez comme avatar, et pour scanner les codes QR lors de l'association de contacts ou de l'importation de clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet die Kamera für Ende-zu-Ende-verschlüsselte Videoanrufe, um Fotos aufzunehmen, die du in Chats sendest oder als Profilbild festlegst, und um QR-Codes beim Verknüpfen von Kontakten oder Importieren von Schlüsseln zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa a câmera para chamadas de vídeo com criptografia de ponta a ponta, para tirar fotos que você envia nas conversas ou define como avatar, e para escanear códigos QR ao parear contatos ou importar chaves."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "comment": "Contacts: optional address-book import, hashed on device",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion can use your contacts so you can import them into your encrypted address book, and to automatically show the name and photo of a phone contact when they call you or you call them. To find contacts already on Q-Audion, phone numbers are hashed on your device before matching; names and photos never leave your phone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion può usare i tuoi contatti per importarli nella rubrica cifrata e per mostrare automaticamente nome e foto di un contatto quando ti chiama o lo chiami. Per trovare i contatti già su Q-Audion, i numeri di telefono vengono sottoposti ad hash sul dispositivo prima del confronto; nomi e foto non lasciano mai il telefono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion puede usar tus contactos para importarlos a tu agenda cifrada y para mostrar automáticamente el nombre y la foto de un contacto cuando te llama o lo llamas. Para encontrar contactos que ya usan Q-Audion, los números de teléfono se cifran con hash en tu dispositivo antes de la comparación; los nombres y las fotos nunca salen de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion peut utiliser vos contacts pour les importer dans votre carnet d'adresses chiffré, et pour afficher automatiquement le nom et la photo d'un contact lorsqu'il vous appelle ou que vous l'appelez. Pour trouver les contacts déjà présents sur Q-Audion, les numéros de téléphone sont hachés sur votre appareil avant la comparaison ; les noms et les photos ne quittent jamais votre téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion kann deine Kontakte verwenden, um sie in dein verschlüsseltes Adressbuch zu importieren und um Name und Foto eines Kontakts automatisch anzuzeigen, wenn er dich anruft oder du ihn anrufst. Um Kontakte zu finden, die Q-Audion bereits nutzen, werden Telefonnummern vor dem Abgleich auf deinem Gerät gehasht; Namen und Fotos verlassen dein Telefon nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion pode usar seus contatos para importá-los para sua agenda criptografada e para mostrar automaticamente o nome e a foto de um contato quando ele liga para você ou você liga para ele. Para encontrar contatos que já usam o Q-Audion, os números de telefone recebem hash no seu dispositivo antes da comparação; nomes e fotos nunca saem do seu telefone."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "comment": "Photo library: save-to-Photos for chat images",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion saves chat images you choose to keep into your Photos library."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion salva nella libreria Foto le immagini della chat che scegli di conservare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion guarda en tu biblioteca de Fotos las imágenes del chat que decides conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion enregistre dans votre photothèque les images de discussion que vous choisissez de conserver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion speichert Chatbilder, die du behalten möchtest, in deiner Fotomediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion salva na sua biblioteca de Fotos as imagens do chat que você optar por manter."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "comment": "Face ID: unlock the app when app-lock is enabled",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses Face ID to unlock the app when the app lock feature is enabled."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Face ID per sbloccare l'app quando la funzione di blocco app è attiva."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Face ID para desbloquear la app cuando la función de bloqueo de app está activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise Face ID pour déverrouiller l'application lorsque la fonction de verrouillage d'application est activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet Face ID, um die App zu entsperren, wenn die App-Sperre aktiviert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa o Face ID para desbloquear o app quando o recurso de bloqueio de app está ativado."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "comment": "Bluetooth: in-person QR pairing key exchange + BLE mesh relay (starts with the app; can be turned off in the mesh panel)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa il Bluetooth per scambiare le chiavi di cifratura con il telefono di un contatto quando lo associ di persona (un telefono mostra un codice QR, l'altro lo inquadra) e per la mesh Bluetooth, che inoltra messaggi cifrati ai dispositivi Q-Audion vicini quando manca la rete. La mesh si avvia con l'app e puoi spegnerla in qualsiasi momento dal pannello Mesh Bluetooth di una chat (Antenna > Spenta)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses Bluetooth to exchange encryption keys with a contact's phone when you pair in person (one phone shows a QR code, the other scans it), and for Bluetooth mesh, which relays encrypted messages to nearby Q-Audion devices when there is no network. The mesh starts with the app, and you can turn it off at any time from the Bluetooth mesh panel of a chat (Antenna control)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Bluetooth para intercambiar claves de cifrado con el teléfono de un contacto cuando lo emparejas en persona (un teléfono muestra un código QR y el otro lo escanea) y para la mesh Bluetooth, que retransmite mensajes cifrados a dispositivos Q-Audion cercanos cuando no hay red. La mesh se inicia con la app y puedes apagarla en cualquier momento desde el panel Mesh Bluetooth de un chat (control Antena)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le Bluetooth pour échanger des clés de chiffrement avec le téléphone d'un contact lorsque vous l'associez en personne (un téléphone affiche un code QR, l'autre le scanne) et pour le mesh Bluetooth, qui relaie des messages chiffrés vers des appareils Q-Audion à proximité en l'absence de réseau. Le mesh démarre avec l'application et vous pouvez l'éteindre à tout moment depuis le panneau Mesh Bluetooth d'une discussion (commande Antenne)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet Bluetooth, um Verschlüsselungsschlüssel mit dem Telefon eines Kontakts auszutauschen, wenn Sie ihn persönlich koppeln (ein Telefon zeigt einen QR-Code, das andere scannt ihn), und für das Bluetooth-Mesh, das verschlüsselte Nachrichten an nahegelegene Q-Audion-Geräte weiterleitet, wenn kein Netzwerk verfügbar ist. Das Mesh startet mit der App, und Sie können es jederzeit im Bluetooth-Mesh-Fenster eines Chats ausschalten (Bedienelement Antenne)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa Bluetooth para trocar chaves de criptografia com o telefone de um contato quando você o pareia pessoalmente (um telefone mostra um código QR e o outro o escaneia) e para a mesh Bluetooth, que retransmite mensagens criptografadas para dispositivos Q-Audion próximos quando não há rede. A mesh inicia com o app e você pode desativá-la a qualquer momento no painel Mesh Bluetooth de uma conversa (controle Antena)."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "comment": "Local network: direct P2P calls on the same Wi-Fi (host ICE candidates)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion connects directly to other Q-Audion devices on your local network for lower-latency encrypted calls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion si collega direttamente ad altri dispositivi Q-Audion sulla tua rete locale per chiamate cifrate con latenza più bassa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion se conecta directamente con otros dispositivos Q-Audion en tu red local para llamadas cifradas con menor latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion se connecte directement à d'autres appareils Q-Audion sur votre réseau local pour des appels chiffrés à latence réduite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verbindet sich direkt mit anderen Q-Audion-Geräten in deinem lokalen Netzwerk für verschlüsselte Anrufe mit geringerer Latenz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion se conecta diretamente a outros dispositivos Q-Audion na sua rede local para chamadas criptografadas com menor latência."
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "extractionState": "manual",
      "comment": "Siri: start a call by contact name (on-device only)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion shares your contact names with Siri so you can start an encrypted call by saying \"Call [name] on Q-Audion\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion condivide con Siri i nomi dei tuoi contatti per permetterti di avviare una chiamata cifrata dicendo \"Chiama [nome] su Q-Audion\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion comparte los nombres de tus contactos con Siri para que puedas iniciar una llamada cifrada diciendo \"Llama a [nombre] en Q-Audion\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion partage les noms de vos contacts avec Siri afin que vous puissiez lancer un appel chiffré en disant « Appelle [nom] sur Q-Audion »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion teilt deine Kontaktnamen mit Siri, damit du einen verschlüsselten Anruf starten kannst, indem du „Rufe [Name] auf Q-Audion an\" sagst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion compartilha os nomes dos seus contatos com a Siri para que você possa iniciar uma chamada criptografada dizendo \"Ligar para [nome] no Q-Audion\"."
          }
        }
      }
    }
  },
  "version": "1.0"
}
