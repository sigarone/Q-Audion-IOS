<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy - Q-Audion iOS (QAudionApp target)

  Apple privacy manifest. Required at the app bundle root (ITMS-91061)
  and its required-reason API list must cover every such API the app
  binary calls (ITMS-91053). Declaration discipline: every entry below is
  backed by a real call site or a real egress in QAudionApp / QAudionEngine
  (file noted), and the App Store Connect "App Privacy" labels are entered
  from this same list so the two never disagree.

  Verified against TN3183 (required-reason API codes) and TN3184 (data
  collection). Third-party dependencies (onnxruntime 1.24.2, GRDB, the
  LiveKit/WebRTC forks, WireGuardKit, liboqs/COpus/SILK inside
  QAudionEngine) ship their own manifest where Apple requires one; this
  file covers only first-party code.

  Rebuilt 2026-09-12 (App Store readiness audit, FIX-02/FIX-03).
-->
<plist version="1.0">
<dict>
    <!-- Tracking: none. No cross-app/website tracking, no advertising,
         no ATTrackingManager/ASIdentifierManager anywhere. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- =========================================================
         Collected data (TN3184)
         "Collected" per Apple = transmitted off the device. That includes
         end-to-end-encrypted payloads that transit our own relay even
         though the server cannot read them. Every entry is Linked=true
         (sent on an authenticated session tied to the account) and
         Tracking=false.
         ========================================================= -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Phone number - transmitted ONCE in clear for the SMS OTP
             (BCryptoAccountApiImpl register/verify), then stored server-side
             only as a peppered SHA-256 hash for reciprocal contact discovery.
             Optional: extension-only accounts have no phone number. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhoneNumber</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Email address - mandatory on the extension-only registration path
             (ExtensionOnlyRegisterScreen -> BCryptoAccountApiImpl), used for
             verification and account recovery. Optional overall. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Name - the user's display name sent at registration and in profile
             updates. Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Contacts - address-book phone numbers are uploaded ONLY as peppered
             SHA-256 hashes, and only after an explicit import tap or
             pull-to-refresh (PhonebookSyncCoordinator, ContactsRefreshService);
             names and photos never leave the device. Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeContacts</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- User ID - opaque server-issued account identifier sent on every
             authenticated REST/WebSocket call. Required. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Device ID - APNs and PushKit VoIP tokens registered with the server so
             incoming calls and messages can wake the device (AppState
             registerVoipPushToken / handleApnsDeviceToken); the earbud
             accessory id when the optional Q-Audion earbuds are paired
             (BCryptoKmsClient). Required for the service. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Emails or Text Messages - chat messages. Plaintext never leaves the
             device (post-quantum hybrid: ML-KEM-1024 KEM + AES-256-GCM AEAD);
             the relay only sees opaque ciphertext. Required. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Audio Data - voice calls (SFrame/SRTP end-to-end encryption) and
             voice notes, as ciphertext through our relay. Required. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAudioData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Photos or Videos - chat image/video attachments, the avatar (per-peer
             ciphertext, AvatarUploader) and video-call frames, all as
             end-to-end-encrypted ciphertext through the relay. Required for
             those features. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Crash Data - in-house CrashReporter/MetricKit output, shipped only
             under the diagnostics opt-in (Settings > Privacy > Diagnostica,
             default OFF). Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Performance Data - call-pipeline metrics via TelemetryService, same
             opt-in, default OFF. Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePerformanceData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Other Diagnostic Data - redacted application log lines (LiveLogStreamer,
             "Log diagnostici in tempo reale", default OFF) and the automatic
             error report (BugReporter.triggerAuto, gated on the same
             diagnostics opt-in since 2026-09-12). User-initiated bug/abuse
             reports are content the user chooses to send. Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!-- Product Interaction - app.launch / ws.state events, emitted only under
             the diagnostics opt-in (AppState telemetry wiring). Optional. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!-- =========================================================
         Required-reason API access (TN3183)
         Every category below has a real first-party call site:
           UserDefaults    - persistence layer throughout the app (CA92.1)
                             and the Siri App Group suite shared with the
                             QAudionIntents extension
                             (SiriMessageBridgeStore.swift, 1C8F.1).
           FileTimestamp   - FileManager.fileExists / attributes in
                             BackupCoordinator and the log export (C617.1).
           SystemBootTime  - ProcessInfo.systemUptime deltas for call timing
                             and diagnostics (CallService, StaticUptimeAnchor,
                             SettingsScreen, AboutSettingsScreen,
                             DiagnosticsExportScreen, PlayoutJitterBuffer)
                             - 35F9.1.
           DiskSpace       - volumeAvailableCapacityForImportantUsage shown
                             in About and written into the diagnostics export
                             (AboutSettingsScreen, DiagnosticsExportScreen)
                             - E174.1 + 85F4.1.
           ActiveKeyboards - not used.
         ========================================================= -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
                <string>85F4.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
