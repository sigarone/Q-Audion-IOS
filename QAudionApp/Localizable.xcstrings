    },
    "Scegli da quale paese esce il traffico VPN. \"Auto\" sceglie il nodo migliore. La scelta vale dalla prossima connessione VPN.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da quale paese esce il traffico VPN. \"Auto\" sceglie il nodo migliore. La scelta vale dalla prossima connessione VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which country your VPN traffic exits from. \"Auto\" picks the best node. The choice applies from the next VPN connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, über welches Land der VPN-Datenverkehr ausgeleitet wird. „Auto“ wählt den besten Knoten. Die Auswahl gilt ab der nächsten VPN-Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige desde qué país sale el tráfico VPN. \"Auto\" elige el mejor nodo. La elección se aplica desde la próxima conexión VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis le pays par lequel sort le trafic VPN. « Auto » choisit le meilleur nœud. Le choix s'applique à partir de la prochaine connexion VPN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de qual país sai o tráfego VPN. \"Auto\" escolhe o melhor nó. A escolha vale a partir da próxima conexão VPN."
          }
        }
      }
    },
