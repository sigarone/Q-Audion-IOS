          "stringUnit": {
            "state": "translated",
            "value": "Create a password to protect the backup. You'll need it to restore the backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una contraseña para proteger la copia de seguridad. La necesitarás para restaurarla."
