            "state": "translated",
            "value": "Yes please. Let's talk by voice tonight, I've got the new key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, gracias. Esta noche hablamos por voz, tengo la clave nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui merci. On s'appelle ce soir en vocal, j'ai la nouvelle clé."
