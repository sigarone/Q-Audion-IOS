    "Invia metriche della pipeline di chiamata (audio, rete, self-test) cifrate con X25519+AES-GCM, decifrabili solo lato server. ID sessione temporaneo, non raccoglie messaggi né contatti. Disattivato di default.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia metriche della pipeline di chiamata (audio, rete, self-test) cifrate con X25519+AES-GCM, decifrabili solo lato server. ID sessione temporaneo, non raccoglie messaggi né contatti. Disattivato di default."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends call pipeline metrics (audio, network, self-test) encrypted with X25519+AES-GCM, decryptable only on the server side. Temporary session ID, collects no messages or contacts. Off by default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les métriques du pipeline d'appel (audio, réseau, auto-test) chiffrées avec X25519+AES-GCM, déchiffrables uniquement côté serveur. ID de session temporaire, ne collecte ni messages ni contacts. Désactivé par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Metriken der Anruf-Pipeline (Audio, Netzwerk, Selbsttest), verschlüsselt mit X25519+AES-GCM und nur serverseitig entschlüsselbar. Temporäre Sitzungs-ID, erfasst weder Nachrichten noch Kontakte. Standardmäßig deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía métricas del pipeline de llamada (audio, red, autotest) cifradas con X25519+AES-GCM, descifrables solo en el servidor. ID de sesión temporal, no recopila mensajes ni contactos. Desactivado por defecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia métricas do pipeline de chamada (áudio, rede, autoteste) criptografadas com X25519+AES-GCM, descriptografáveis apenas no servidor. ID de sessão temporário, não coleta mensagens nem contatos. Desativado por padrão."
          }
        }
      }
    },
    "Log diagnostici in tempo reale": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Log diagnostici in tempo reale"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-time diagnostic logs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de diagnostic en temps réel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseprotokolle in Echtzeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de diagnóstico en tiempo real"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs de diagnóstico em tempo real"
          }
        }
      }
    },
    "Invia log applicativi redatti (tag, dimensioni, fingerprint troncati — mai chiavi, token o contenuto messaggi) al backend di diagnostica ogni pochi secondi mentre l'app è in uso. Canale separato dal precedente. Disattivato di default.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia log applicativi redatti (tag, dimensioni, fingerprint troncati — mai chiavi, token o contenuto messaggi) al backend di diagnostica ogni pochi secondi mentre l'app è in uso. Canale separato dal precedente. Disattivato di default."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends redacted application logs (tags, sizes, truncated fingerprints — never keys, tokens or message content) to the diagnostics backend every few seconds while the app is in use. Separate channel from the previous one. Off by default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie des journaux d'application expurgés (étiquettes, tailles, empreintes tronquées — jamais de clés, de jetons ni de contenu de messages) au backend de diagnostic toutes les quelques secondes pendant l'utilisation de l'app. Canal distinct du précédent. Désactivé par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet bereinigte Anwendungsprotokolle (Tags, Größen, gekürzte Fingerabdrücke — niemals Schlüssel, Token oder Nachrichteninhalte) alle paar Sekunden an das Diagnose-Backend, solange die App verwendet wird. Getrennter Kanal vom vorherigen. Standardmäßig deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía registros de la aplicación depurados (etiquetas, tamaños, huellas truncadas — nunca claves, tokens ni contenido de mensajes) al backend de diagnóstico cada pocos segundos mientras se usa la app. Canal independiente del anterior. Desactivado por defecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia logs do aplicativo com dados sensíveis removidos (tags, tamanhos, impressões digitais truncadas — nunca chaves, tokens ou conteúdo de mensagens) ao backend de diagnóstico a cada poucos segundos enquanto o app está em uso. Canal separado do anterior. Desativado por padrão."
          }
        }
      }
    },
