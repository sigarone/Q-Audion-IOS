    "Inietta latenza / perdita pacchetti / offline nelle chiamate attive. Il profilo \"Normale\" ripristina il comportamento di produzione.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inietta latenza / perdita pacchetti / offline nelle chiamate attive. Il profilo \"Normale\" ripristina il comportamento di produzione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Injects latency / packet loss / offline into active calls. The \"Normal\" profile restores production behavior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt in aktiven Anrufen Latenz / Paketverlust / Offline-Zustand ein. Das Profil „Normal“ stellt das Produktionsverhalten wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyecta latencia / pérdida de paquetes / desconexión en las llamadas activas. El perfil \"Normal\" restablece el comportamiento de producción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Injecte de la latence / une perte de paquets / une mise hors ligne dans les appels actifs. Le profil « Normal » rétablit le comportement de production."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Injeta latência / perda de pacotes / modo offline nas chamadas ativas. O perfil \"Normal\" restaura o comportamento de produção."
          }
        }
      }
    },
