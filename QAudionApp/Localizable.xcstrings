          "stringUnit": {
            "state": "translated",
            "value": "Delete the voice model recorded on this device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le modèle vocal enregistré sur cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das auf diesem Gerät gespeicherte Stimmmodell löschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar el modelo de voz grabado en este dispositivo"
          }
        },
