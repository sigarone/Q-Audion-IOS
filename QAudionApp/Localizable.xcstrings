        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío si no conoces el ID — podrás completarlo más tarde desde el detalle del contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse vide si tu ne connais pas l'ID — tu pourras le compléter plus tard depuis la fiche du contact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, wenn Sie die ID nicht kennen — Sie können sie später in den Kontaktdetails ergänzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco se você não souber o ID — você pode completar depois pelo detalhe do contato."
          }
        }
      }
    },
    "Le chiamate in entrata e i messaggi sono silenziati durante questa fascia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate in entrata e i messaggi sono silenziati durante questa fascia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming calls and messages are silenced during this time window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas entrantes y los mensajes se silencian durante esta franja horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels entrants et les messages sont mis en silencieux pendant cette plage horaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehende Anrufe und Nachrichten werden während dieses Zeitraums stummgeschaltet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas recebidas e as mensagens ficam silenciadas durante esse período."
          }
        }
      }
    },
    "Le foto e i vocali ricevuti verranno ri-scaricati dai mittenti la prossima volta che li apri. La cronologia dei messaggi non viene toccata.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto e i vocali ricevuti verranno ri-scaricati dai mittenti la prossima volta che li apri. La cronologia dei messaggi non viene toccata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received photos and voice notes will be re-downloaded from senders the next time you open them. Message history isn't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los audios recibidos volverán a descargarse de los remitentes la próxima vez que los abras. El historial de mensajes no se ve afectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et les vocaux reçus seront retéléchargés depuis leurs expéditeurs la prochaine fois que tu les ouvres. L'historique des messages n'est pas modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfangene Fotos und Sprachnachrichten werden beim nächsten Öffnen erneut von den Absendern heruntergeladen. Der Nachrichtenverlauf bleibt unangetastet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e os áudios recebidos serão baixados novamente dos remetentes na próxima vez que você abri-los. O histórico de mensagens não é afetado."
          }
        }
      }
    },
    "Le password non coincidono": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le password non coincidono"
          }
        },
        "en": {
