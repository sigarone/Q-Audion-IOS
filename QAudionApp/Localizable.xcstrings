    "transport_settings.check.not_saved": {
      "extractionState": "manual",
      "comment": "Transport settings — shown under a check result when the checked mode or the checked address (or both) differs from the saved one",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo è stato fatto con una modalità o un indirizzo non ancora salvati: premi Salva per usarli nelle chiamate 1 a 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This check ran with a mode or an address that is not saved yet: tap Save to use them in 1-to-1 calls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Prüfung lief mit einem Modus oder einer Adresse, die noch nicht gespeichert sind: Tippen Sie auf Speichern, um sie in 1:1-Anrufen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comprobación se hizo con un modo o una dirección que todavía no están guardados: pulsa Guardar para usarlos en las llamadas 1 a 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vérification a été faite avec un mode ou une adresse pas encore enregistrés : appuie sur Enregistrer pour les utiliser dans les appels 1 à 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificação foi feita com um modo ou um endereço que ainda não foram salvos: toque em Salvar para usá-los nas chamadas 1 a 1."
          }
        }
      }
    },
    "transport_settings.saved.note": {
      "extractionState": "manual",
