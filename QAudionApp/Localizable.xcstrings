    },
    "L'altro utente vuole abilitare gli screenshot in questa chat. Approvi?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro utente vuole abilitare gli screenshot in questa chat. Approvi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other user wants to enable screenshots in this chat. Approve?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro usuario quiere habilitar las capturas de pantalla en este chat. ¿Apruebas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre utilisateur veut activer les captures d'écran dans cette discussion. Approuves-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
