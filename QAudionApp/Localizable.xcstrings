    "mesh.sheet.toast_target_set_visible": {
      "extractionState": "manual",
      "comment": "Bluetooth mesh sheet, toast: sending through the mesh is on for a device, but in visible mode this phone cannot start the link; %@ is the device name.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio via mesh attivato — %@. In modalità Visibile questo telefono non avvia il collegamento: la consegna dipende dall'altro dispositivo. Passa a Diretta o Mesh completa per inviare subito."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending via mesh turned on — %@. In Visible mode this phone doesn't start the connection: delivery depends on the other device. Switch to Direct or Full mesh to send right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envío por la mesh activado — %@. En modo Visible este teléfono no inicia la conexión: la entrega depende del otro dispositivo. Cambia a Directa o Mesh completa para enviar de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi via le mesh activé — %@. En mode Visible, ce téléphone n'établit pas la connexion : la remise dépend de l'autre appareil. Passe à Directe ou à Mesh complet pour envoyer tout de suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden über das Mesh aktiviert — %@. Im Modus „Sichtbar“ baut dieses Telefon keine Verbindung auf: Die Zustellung hängt vom anderen Gerät ab. Wechseln Sie zu „Direkt“ oder „Vollständiges Mesh“, um sofort zu senden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio pela mesh ativado — %@. No modo Visível, este telefone não inicia a conexão: a entrega depende do outro dispositivo. Mude para Direta ou Mesh completa para enviar agora mesmo."
          }
        }
      }
    },
