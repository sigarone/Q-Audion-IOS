    "pairing.status.screen_captured": {
      "extractionState": "manual",
      "comment": "In-person pairing: the QR code is hidden while the screen is being recorded or shared",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo è registrato o condiviso: il codice resta nascosto finché non interrompi la registrazione o la condivisione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen is being recorded or shared: the code stays hidden until you stop recording or sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se está grabando o compartiendo: el código permanece oculto hasta que detengas la grabación o el uso compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran est enregistré ou partagé : le code reste masqué tant que tu n'arrêtes pas l'enregistrement ou le partage."
