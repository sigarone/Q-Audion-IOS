    "I contatti che blocchi appariranno qui. Puoi sbloccarli in qualsiasi momento dal loro dettaglio.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contatti che blocchi appariranno qui. Puoi sbloccarli in qualsiasi momento dal loro dettaglio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts you block will appear here. You can unblock them anytime from their detail page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contactos que bloquees aparecerán aquí. Puedes desbloquearlos en cualquier momento desde su detalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contacts que tu bloques apparaîtront ici. Tu peux les débloquer à tout moment depuis leur fiche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakte, die Sie blockieren, werden hier angezeigt. Sie können sie jederzeit über ihre Detailansicht entsperren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contatos que você bloquear vão aparecer aqui. Você pode desbloqueá-los a qualquer momento pelo detalhe deles."
          }
        }
      }
    },
    "I contatti non potranno più raggiungerti su questo numero.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contatti non potranno più raggiungerti su questo numero."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts will no longer be able to reach you on this number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus contactos ya no podrán contactarte en este número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contacts ne pourront plus te joindre sur ce numéro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakte können Sie über diese Nummer nicht mehr erreichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contatos não vão mais conseguir te encontrar por este número."
          }
        }
      }
    },
    "I messaggi e le chiamate sono protetti con ML-KEM-1024 post-quantum. Nessun altro, nemmeno Q-Audion, può leggerli o ascoltarli.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi e le chiamate sono protetti con ML-KEM-1024 post-quantum. Nessun altro, nemmeno Q-Audion, può leggerli o ascoltarli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages and calls are protected with post-quantum ML-KEM-1024. No one else, not even Q-Audion, can read or listen to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes y las llamadas están protegidos con ML-KEM-1024 poscuántico. Nadie más, ni siquiera Q-Audion, puede leerlos ni escucharlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages et les appels sont protégés avec ML-KEM-1024 post-quantique. Personne d'autre, pas même Q-Audion, ne peut les lire ou les écouter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten und Anrufe sind mit postquantischem ML-KEM-1024 geschützt. Niemand sonst, nicht einmal Q-Audion, kann sie lesen oder mithören."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens e as chamadas são protegidas com ML-KEM-1024 pós-quântico. Ninguém mais, nem mesmo o Q-Audion, pode lê-las ou ouvi-las."
          }
        }
      }
    },
    "I messaggi verranno eliminati automaticamente. \\\"Visualizza una volta\\\" li elimina appena aperti.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi verranno eliminati automaticamente. \\\"Visualizza una volta\\\" li elimina appena aperti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages will be deleted automatically. \\\"View once\\\" deletes them as soon as they're opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se eliminarán automáticamente. \\\"Ver una vez\\\" los elimina en cuanto se abren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages seront supprimés automatiquement. \\\"Voir une seule fois\\\" les supprime dès leur ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten werden automatisch gelöscht. \\\"Einmal ansehen\\\" löscht sie, sobald sie geöffnet wurden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens serão apagadas automaticamente. \\\"Visualizar uma vez\\\" as apaga assim que abertas."
          }
        }
      }
    },
