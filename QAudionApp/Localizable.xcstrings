    "Sistema RTLog cattura eventi app (call setup, WS, errori) in un buffer in-memory. Niente token, niente messaggi utente. Esportabile per debug remoto.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema RTLog cattura eventi app (call setup, WS, errori) in un buffer in-memory. Niente token, niente messaggi utente. Esportabile per debug remoto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The RTLog system captures app events (call setup, WS, errors) in an in-memory buffer. No tokens, no user messages. Exportable for remote debugging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema RTLog captura eventos de la app (call setup, WS, errores) en un búfer en memoria. Sin tokens, sin mensajes de usuario. Exportable para depuración remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système RTLog capture les événements de l'app (call setup, WS, erreurs) dans un buffer en mémoire. Aucun token, aucun message utilisateur. Exportable pour le débogage distant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das RTLog-System erfasst App-Ereignisse (Anrufaufbau, WS, Fehler) in einem In-Memory-Puffer. Keine Token, keine Benutzernachrichten. Exportierbar für Remote-Debugging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema RTLog captura eventos do app (setup de chamada, WS, erros) em um buffer em memória. Sem tokens, sem mensagens de usuário. Exportável para debug remoto."
          }
        }
      }
    },
    "Solo per account configurati con Configurazione rapida (QR). Se non hai un interno e una password assegnati, usa la scansione del QR o un'altra modalità di accesso.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per account configurati con Configurazione rapida (QR). Se non hai un interno e una password assegnati, usa la scansione del QR o un'altra modalità di accesso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for accounts set up with Quick setup (QR). If you don't have an assigned extension and password, use QR scanning or another sign-in method."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para cuentas configuradas con Configuración rápida (QR). Si no tienes una extensión y una contraseña asignadas, usa el escaneo del QR u otro modo de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les comptes configurés avec Configuration rapide (QR). Si tu n'as pas de poste et de mot de passe assignés, utilise le scan du QR ou un autre mode de connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Konten, die mit Schnellkonfiguration (QR) eingerichtet sind. Wenn Ihnen keine Nebenstelle und kein Passwort zugewiesen wurden, nutzen Sie den QR-Scan oder eine andere Anmeldemethode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente para contas configuradas com Configuração rápida (QR). Se você não tiver um ramal e uma senha atribuídos, use a leitura do QR ou outro modo de acesso."
          }
        }
      }
    },
