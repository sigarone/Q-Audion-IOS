    "trust.assurance.nfc_unattestable": {
      "extractionState": "manual",
      "comment": "In-call security warning: the key was restored from a backup, so this device cannot prove that it was verified in person",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave ripristinata da backup: la verifica di persona non è attestabile su questo dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key restored from backup: in-person verification cannot be attested on this device."
