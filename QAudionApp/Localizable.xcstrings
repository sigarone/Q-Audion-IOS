    "Rilevatore di attività/energia 2.4 GHz (non analizzatore di spettro): segnala emettitori vicini/forti come candidati da ispezionare, non identificazioni certe.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevatore di attività/energia 2.4 GHz (non analizzatore di spettro): segnala emettitori vicini/forti come candidati da ispezionare, non identificazioni certe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2.4 GHz activity/energy detector (not a spectrum analyzer): flags nearby/strong emitters as candidates to inspect, not certain identifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detector de actividad/energía de 2,4 GHz (no un analizador de espectro): señala emisores cercanos/fuertes como candidatos a inspeccionar, no identificaciones certeras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecteur d'activité/énergie 2,4 GHz (pas un analyseur de spectre) : signale les émetteurs proches/forts comme candidats à inspecter, pas comme des identifications certaines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitäts-/Energiedetektor 2,4 GHz (kein Spektrumanalysator): meldet nahe/starke Sender als zu prüfende Kandidaten, keine gesicherten Identifikationen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detector de atividade/energia de 2,4 GHz (não é um analisador de espectro): sinaliza emissores próximos/fortes como candidatos a inspecionar, não identificações certas."
          }
        }
      }
    },
