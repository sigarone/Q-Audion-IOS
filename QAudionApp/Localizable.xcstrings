    "Per ogni contatto, il flag v3-capable viene osservato e persiste. Reset → re-discovery automatica al prossimo messaggio inbound.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ogni contatto, il flag v3-capable viene osservato e persiste. Reset → re-discovery automatica al prossimo messaggio inbound."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each contact, the v3-capable flag is observed and persists. Reset → automatic re-discovery on the next inbound message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cada contacto, el flag v3-capable se observa y persiste. Reset → re-discovery automático en el próximo mensaje entrante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour chaque contact, l'indicateur v3-capable est observé et persiste. Réinitialisation → redécouverte automatique au prochain message entrant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jeden Kontakt wird das v3-capable-Flag beobachtet und bleibt bestehen. Reset → automatische erneute Discovery bei der nächsten eingehenden Nachricht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cada contato, a flag v3-capable é observada e persiste. Reset → nova descoberta automática na próxima mensagem recebida."
          }
        }
      }
    },
