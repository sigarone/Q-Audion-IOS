    "ota.channel.beta_desc": {
      "extractionState": "manual",
      "comment": "OTA update screen, release channel card: description when the beta channel is on",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi build pre-rilascio firmate. Possono contenere bug — rientri in stable disattivando l'opzione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive signed pre-release builds. They may contain bugs — turn this off to go back to stable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes builds preliminares firmadas. Pueden contener errores: desactiva la opción para volver a stable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reçois des builds préliminaires signés. Ils peuvent contenir des bugs — désactive l'option pour revenir à la version stable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erhalten signierte Vorabversionen. Sie können Fehler enthalten — durch Deaktivieren der Option kehren Sie zu Stable zurück."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você recebe builds de pré-lançamento assinadas. Elas podem conter bugs — desative a opção para voltar ao stable."
          }
        }
      }
    },
