            "value": "Immagine non inviata: da questo formato non si possono togliere la posizione e i dati del dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image not sent: the location and device data cannot be removed from this format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild nicht gesendet: Aus diesem Format lassen sich Standort und Gerätedaten nicht entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen no enviada: de este formato no se pueden quitar la ubicación y los datos del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image non envoyée : impossible de supprimer la position et les données de l'appareil de ce format."
