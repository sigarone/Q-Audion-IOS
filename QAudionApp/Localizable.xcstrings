            "state": "translated",
            "value": "Léelo en voz alta y compáralo con la pantalla del otro dispositivo antes de confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis-le à voix haute et compare-le avec l’écran de l’autre appareil avant de confirmer."
          }
        },
        "de": {
          "stringUnit": {
