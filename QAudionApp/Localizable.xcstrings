    "pairing.error.timeout": {
      "extractionState": "manual",
      "comment": "In-person pairing error: the other phone did not answer in time; addressed to both people ('bring the phones closer and try again')",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altro telefono non ha risposto in tempo. Avvicinate i telefoni e riprovate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other phone didn't answer in time. Bring the phones closer and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro teléfono no ha respondido a tiempo. Acerca los teléfonos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autre téléphone n'a pas répondu à temps. Rapproche les téléphones et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Telefon hat nicht rechtzeitig geantwortet. Halten Sie die Telefone näher zusammen und versuchen Sie es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro telefone não respondeu a tempo. Aproximem os telefones e tentem novamente."
          }
        }
      }
    },
    "pairing.error.transport_failed": {
      "extractionState": "manual",
      "comment": "In-person pairing error: the Bluetooth connection between the two phones dropped",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione Bluetooth interrotta. Riprova tenendo i telefoni vicini."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth connection lost. Try again keeping the phones close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión Bluetooth interrumpida. Inténtalo de nuevo con los teléfonos cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion Bluetooth interrompue. Réessaie en gardant les téléphones proches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-Verbindung unterbrochen. Versuchen Sie es erneut und halten Sie die Telefone nah beieinander."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexão Bluetooth interrompida. Tente novamente mantendo os telefones próximos."
          }
        }
      }
    },
    "pairing.error.security_check_failed": {
      "extractionState": "manual",
      "comment": "In-person pairing error: the security check failed, pairing was cancelled and nothing was saved",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica di sicurezza non superata: associazione annullata, nessuna chiave salvata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security check failed: pairing canceled, no key saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificación de seguridad no superada: emparejamiento cancelado, no se guardó ninguna clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la vérification de sécurité : association annulée, aucune clé enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitsprüfung nicht bestanden: Kopplung abgebrochen, kein Schlüssel gespeichert."
