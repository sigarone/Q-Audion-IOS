    "La segnalazione viene inviata cifrata al nostro team e gestita entro 2 giorni lavorativi. Non contiene i messaggi del gruppo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La segnalazione viene inviata cifrata al nostro team e gestita entro 2 giorni lavorativi. Non contiene i messaggi del gruppo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report is sent encrypted to our team and handled within 2 working days. It does not contain the group's messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meldung wird verschlüsselt an unser Team gesendet und innerhalb von 2 Werktagen bearbeitet. Sie enthält keine Nachrichten der Gruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reporte se envía cifrado a nuestro equipo y se gestiona en un plazo de 2 días laborables. No contiene los mensajes del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signalement est envoyé chiffré à notre équipe et traité sous 2 jours ouvrés. Il ne contient pas les messages du groupe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A denúncia é enviada criptografada à nossa equipe e tratada em até 2 dias úteis. Ela não contém as mensagens do grupo."
          }
        }
      }
    },
