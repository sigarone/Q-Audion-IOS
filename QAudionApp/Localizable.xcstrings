            "state": "translated",
            "value": "Tendrás que volver a iniciar sesión para usar los chats y las llamadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu devras te reconnecter pour utiliser les discussions et les appels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen sich erneut anmelden, um Chats und Anrufe zu nutzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai precisar entrar novamente para usar as conversas e as chamadas."
          }
        }
      }
    },
    "Dovrai accedere di nuovo per usare le chat e le chiamate. I messaggi salvati su questo dispositivo non vengono cancellati.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovrai accedere di nuovo per usare le chat e le chiamate. I messaggi salvati su questo dispositivo non vengono cancellati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to sign in again to use chats and calls. Messages saved on this device aren't deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendrás que volver a iniciar sesión para usar los chats y las llamadas. Los mensajes guardados en este dispositivo no se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu devras te reconnecter pour utiliser les discussions et les appels. Les messages enregistrés sur cet appareil ne sont pas supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen sich erneut anmelden, um Chats und Anrufe zu nutzen. Auf diesem Gerät gespeicherte Nachrichten werden nicht gelöscht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai precisar entrar novamente para usar as conversas e as chamadas. As mensagens salvas neste dispositivo não serão apagadas."
          }
        }
      }
    },
