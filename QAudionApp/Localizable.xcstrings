    "Avviso di sicurezza: la chiave identità del contatto è cambiata e non è pubblicata dal server. Verifica le parole SAS.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso di sicurezza: la chiave identità del contatto è cambiata e non è pubblicata dal server. Verifica le parole SAS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security warning: the contact's identity key has changed and isn't published by the server. Verify the SAS words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de seguridad: la clave de identidad del contacto ha cambiado y no está publicada por el servidor. Verifica las palabras SAS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement de sécurité : la clé d'identité du contact a changé et n'est pas publiée par le serveur. Vérifie les mots SAS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitshinweis: Der Identitätsschlüssel des Kontakts hat sich geändert und ist nicht vom Server veröffentlicht. Überprüfen Sie die SAS-Wörter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de segurança: a chave de identidade do contato mudou e não está publicada no servidor. Verifique as palavras SAS."
          }
        }
      }
    },
    "Avviso di sicurezza: la firma di questa chiamata non corrisponde alla chiave fidata del contatto. Verifica le parole SAS.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso di sicurezza: la firma di questa chiamata non corrisponde alla chiave fidata del contatto. Verifica le parole SAS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security warning: this call's signature doesn't match the contact's trusted key. Verify the SAS words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de seguridad: la firma de esta llamada no coincide con la clave de confianza del contacto. Verifica las palabras SAS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement de sécurité : la signature de cet appel ne correspond pas à la clé de confiance du contact. Vérifie les mots SAS."
