    "Sì grazie. Stasera ci sentiamo su voce, ho la chiave nuova.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì grazie. Stasera ci sentiamo su voce, ho la chiave nuova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes please. Let's talk by voice tonight, I've got the new key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, gracias. Esta noche hablamos por voz, tengo la clave nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui merci. On s'appelle ce soir en vocal, j'ai la nouvelle clé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, danke. Heute Abend sprechen wir per Sprachanruf, ich habe den neuen Schlüssel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, obrigado. Hoje à noite a gente se fala por voz, já tenho a chave nova."
          }
        }
      }
    },
