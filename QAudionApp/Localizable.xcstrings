    "Peers ti raggiungono via uno qualsiasi dei numeri qui sotto. Puoi aggiungerne più di uno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers ti raggiungono via uno qualsiasi dei numeri qui sotto. Puoi aggiungerne più di uno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers can reach you via any of the numbers below. You can add more than one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los peers te contactan a través de cualquiera de los números de abajo. Puedes añadir más de uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes correspondants te joignent via n'importe lequel des numéros ci-dessous. Tu peux en ajouter plusieurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers erreichen Sie über eine der unten aufgeführten Nummern. Sie können mehr als eine hinzufügen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os peers te encontram por qualquer um dos números abaixo. Você pode adicionar mais de um."
          }
        }
      }
    },
    "Per aggiungere o rimuovere numeri vai su Impostazioni > I miei numeri.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere o rimuovere numeri vai su Impostazioni > I miei numeri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
