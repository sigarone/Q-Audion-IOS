    "whats_new.v1196.b2": {
      "extractionState": "manual",
      "comment": "What's new, release v1.0.1196 bullet: a contact paired in person shows a 'Verified in person' reminder with the date",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contatto associato di persona mostra ora un promemoria \"Verificato di persona\" con la data, nella scheda del contatto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A contact paired in person now shows a \"Verified in person\" reminder with the date, on the contact card"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto emparejado en persona ahora muestra un recordatorio \"Verificado en persona\" con la fecha, en su ficha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contact associé en personne affiche désormais un rappel « Vérifié en personne » avec la date, dans sa fiche"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein persönlich gekoppelter Kontakt zeigt jetzt in seiner Kontaktkarte einen Hinweis „Persönlich verifiziert“ mit dem Datum an"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contato pareado pessoalmente agora mostra um lembrete \"Verificado pessoalmente\" com a data, na ficha do contato"
          }
        }
      }
    },
    "whats_new.v1196.b3": {
      "extractionState": "manual",
      "comment": "What's new, release v1.0.1196 bullet: the end-of-pairing screen distinguishes three outcomes",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine, una schermata chiara distingue: nuovo contatto verificato, chiave aggiunta a un contatto già noto, oppure chiave salvata senza verifica server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the end, a clear screen tells apart: new verified contact, key added to an already known contact, or key saved without server verification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar, una pantalla clara distingue: contacto nuevo verificado, clave añadida a un contacto ya conocido o clave guardada sin verificación del servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin, un écran clair distingue : nouveau contact vérifié, clé ajoutée à un contact déjà connu, ou clé enregistrée sans vérification serveur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende unterscheidet ein klarer Bildschirm: neuer verifizierter Kontakt, zu einem bereits bekannten Kontakt hinzugefügter Schlüssel oder ohne Serververifizierung gespeicherter Schlüssel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao final, uma tela clara distingue: novo contato verificado, chave adicionada a um contato já conhecido ou chave salva sem verificação do servidor"
          }
        }
      }
    },
