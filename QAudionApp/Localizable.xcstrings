        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta verificada: a chave deste telefone é a publicada pela conta."
          }
        }
      }
    },
    "pairing.panel.server_unknown": {
      "extractionState": "manual",
      "comment": "In-person pairing: the account could not be checked on the server, so the user must be careful about who is in front of them",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'account sul server: controlla bene chi hai davanti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify the account on the server: look carefully at who is in front of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la cuenta en el servidor: fíjate bien en quién tienes delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le compte sur le serveur : regarde bien qui est en face de toi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto konnte nicht auf dem Server überprüft werden: Achten Sie genau darauf, wer vor Ihnen steht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a conta no servidor: preste atenção em quem está à sua frente."
          }
        }
      }
    },
    "pairing.panel.server_mismatch": {
      "extractionState": "manual",
      "comment": "In-person pairing warning: the account published different keys on the server than the one of the phone in front of the user; confirm only if completely sure",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione: questo account ha pubblicato sul server chiavi diverse da quella di questo telefono. La persona davanti a te potrebbe non essere il titolare dell'account: conferma solo se ne sei certo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: this account has published keys on the server that differ from this phone's. The person in front of you may not be the account holder: confirm only if you are certain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: esta cuenta ha publicado en el servidor claves distintas de la de este teléfono. La persona que tienes delante podría no ser el titular de la cuenta: confirma solo si estás seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : ce compte a publié sur le serveur des clés différentes de celle de ce téléphone. La personne en face de toi n'est peut-être pas le titulaire du compte : ne confirme que si tu en es certain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Dieses Konto hat auf dem Server andere Schlüssel veröffentlicht als den dieses Telefons. Die Person vor Ihnen ist möglicherweise nicht der Kontoinhaber: Bestätigen Sie nur, wenn Sie sich sicher sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção: esta conta publicou no servidor chaves diferentes da deste telefone. A pessoa à sua frente pode não ser a titular da conta: confirme apenas se tiver certeza."
          }
        }
      }
    },
