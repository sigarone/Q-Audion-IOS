      }
    },
    "trust.assurance.kc_failed": {
      "extractionState": "manual",
      "comment": "In-call security warning: the key confirmation with the other participant failed, which may mean someone is actively intercepting the call",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso di sicurezza: la verifica della chiave con l'altro partecipante non è riuscita. Questo può indicare un tentativo di intercettazione attivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security warning: the key verification with the other participant failed. This may indicate an active interception attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de seguridad: la verificación de la clave con el otro participante ha fallado. Esto puede indicar un intento de interceptación activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerte de sécurité : la vérification de la clé avec l'autre participant a échoué. Cela peut indiquer une tentative d'interception active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitswarnung: Die Schlüsselprüfung mit dem anderen Teilnehmer ist fehlgeschlagen. Dies kann auf einen aktiven Abhörversuch hindeuten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de segurança: a verificação da chave com o outro participante falhou. Isso pode indicar uma tentativa de interceptação ativa."
          }
        }
      }
    },
    "trust.assurance.nfc_authenticated": {
      "extractionState": "manual",
      "comment": "In-call security badge: the other person was authenticated in person (NFC tap or QR + Bluetooth pairing) and a pre-shared key is also in use. %@ is the contact's name",
      "localizations": {
