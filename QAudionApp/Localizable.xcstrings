    "whats_new.v1196.b1": {
      "extractionState": "manual",
      "comment": "What's new, release v1.0.1196 bullet: the in-person pairing entry now explains how it works on one screen; menu names must match the app's own labels",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatti → Aggiungi contatto → \"Associa di persona (QR + Bluetooth)\" ora spiega in una schermata come funziona e perché è sicuro, prima di iniziare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts → Add contact → \"Pair in person (QR + Bluetooth)\" now explains on one screen how it works and why it is secure, before you start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactos → Añadir contacto → \"Emparejar en persona (QR + Bluetooth)\" ahora explica en una pantalla cómo funciona y por qué es seguro, antes de empezar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts → Ajouter un contact → « Associer en personne (QR + Bluetooth) » explique désormais en un seul écran comment cela fonctionne et pourquoi c'est sûr, avant de commencer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakte → Kontakt hinzufügen → „Persönlich koppeln (QR + Bluetooth)“ erklärt jetzt vor dem Start auf einem Bildschirm, wie es funktioniert und warum es sicher ist"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatos → Adicionar contato → \"Parear pessoalmente (QR + Bluetooth)\" agora explica em uma tela como funciona e por que é seguro, antes de começar"
          }
        }
      }
