    "reply.refused.changed": {
      "extractionState": "manual",
      "comment": "Shown when the message being answered became a timed or view-once message before the reply was sent; the reply is not sent yet.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio a cui rispondi ora è a scadenza e il suo contenuto non verrà citato. Invia di nuovo per confermare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message you are replying to is now timed, so its content will not be quoted. Send again to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje al que respondes ahora es temporal, por lo que su contenido no se citará. Envía de nuevo para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message auquel vous répondez est désormais temporaire : son contenu ne sera pas cité. Envoyez à nouveau pour confirmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht, auf die du antwortest, ist jetzt zeitlich begrenzt, daher wird ihr Inhalt nicht zitiert. Sende erneut zur Bestätigung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem à qual você responde agora é temporária e seu conteúdo não será citado. Envie novamente para confirmar."
          }
        }
      }
    },
