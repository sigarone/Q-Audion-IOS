    },
    "transport_settings.outcome.server_list_unavailable": {
      "extractionState": "manual",
      "comment": "Transport settings — check verdict: no server to try for the mode, in any mode: the list did not arrive from the server, or nothing in it can be used by the mode",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NON OK: per questa modalità non c'era nessun server da provare, perché dal server BCrypto non è arrivato l'elenco o non contiene nulla che la modalità possa usare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT OK: there was no server to try for this mode, because the list from the BCrypto server did not arrive or has nothing this mode can use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NICHT OK: Für diesen Modus gab es keinen Server zum Testen, weil die Liste des BCrypto-Servers nicht angekommen ist oder nichts enthält, was dieser Modus nutzen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO OK: no había ningún servidor que probar en este modo, porque la lista del servidor BCrypto no llegó o no contiene nada que este modo pueda usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PAS OK : il n'y avait aucun serveur à tester pour ce mode, car la liste du serveur BCrypto n'est pas arrivée ou ne contient rien que ce mode puisse utiliser."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO OK: não havia nenhum servidor para testar neste modo, porque a lista do servidor BCrypto não chegou ou não tem nada que este modo possa usar."
          }
        }
      }
    },
