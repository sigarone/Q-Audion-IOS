    "%@ vuole attivare il video. Se accetti, si attiva anche la tua fotocamera.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole attivare il video. Se accetti, si attiva anche la tua fotocamera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to turn on video. If you accept, your camera will turn on too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte das Video aktivieren. Wenn Sie annehmen, wird auch Ihre Kamera aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere activar el video. Si aceptas, también se activa tu cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veut activer la vidéo. Si tu acceptes, ta caméra s'active aussi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quer ativar o vídeo. Se você aceitar, sua câmera também será ativada."
          }
        }
      }
    },
    "1. Apri Q-Audion sul nuovo dispositivo.\n2. Tocca \"Collega dispositivo\".\n3. Inquadra il QR qui sotto con la fotocamera.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Apri Q-Audion sul nuovo dispositivo.\n2. Tocca \"Collega dispositivo\".\n3. Inquadra il QR qui sotto con la fotocamera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Q-Audion on the new device.\n2. Tap \"Link device\".\n3. Point the camera at the QR code below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffnen Sie Q-Audion auf dem neuen Gerät.\n2. Tippen Sie auf „Gerät verbinden“.\n3. Scannen Sie den QR-Code unten mit der Kamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre Q-Audion en el nuevo dispositivo.\n2. Toca \"Vincular dispositivo\".\n3. Enfoca con la cámara el QR de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvre Q-Audion sur le nouvel appareil.\n2. Appuie sur « Associer un appareil ».\n3. Cadre le QR code ci-dessous avec l'appareil photo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abra o Q-Audion no novo dispositivo.\n2. Toque em \"Vincular dispositivo\".\n3. Aponte a câmera para o QR abaixo."
          }
        }
      }
    },
