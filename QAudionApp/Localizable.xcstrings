    "Procedi solo se hai verificato il nuovo numero col contatto fuori dall'app. Questo accetta la rotazione di chiave permanente.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Procedi solo se hai verificato il nuovo numero col contatto fuori dall'app. Questo accetta la rotazione di chiave permanente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceed only if you've verified the new number with the contact outside the app. This accepts the key rotation permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa solo si has verificado el nuevo número con el contacto fuera de la app. Esto acepta la rotación de clave de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue uniquement si tu as vérifié le nouveau numéro avec le contact en dehors de l'app. Cela accepte la rotation de clé de façon permanente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren Sie nur fort, wenn Sie die neue Nummer außerhalb der App mit dem Kontakt verifiziert haben. Dies akzeptiert die dauerhafte Schlüsselrotation."
