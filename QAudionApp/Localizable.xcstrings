    "qr.fast_setup.error.no_qr_in_image": {
      "extractionState": "manual",
      "comment": "Error on the quick-setup screen: no QR code was found in the picked photo",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun QR trovato nell'immagine. Assicurati che il codice QR sia visibile e ben a fuoco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No QR code found in the image. Make sure the QR code is visible and in focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún QR en la imagen. Asegúrate de que el código QR sea visible y esté bien enfocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun QR code trouvé dans l'image. Assure-toi que le QR code est visible et net."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Bild wurde kein QR-Code gefunden. Achten Sie darauf, dass der QR-Code gut sichtbar und scharf ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum QR code encontrado na imagem. Verifique se o QR code está visível e bem focado."
          }
        }
      }
    },
    "qr.fast_setup.error.server_not_pinned": {
      "extractionState": "manual",
      "comment": "Error on the quick-setup screen: the server named in the scanned QR code is not one of the known addresses of the official server. First %@ is the server found in the QR code, second %@ is the official host name; keep 'DNS' and 'allowlist' as they are",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server nel QR (%@) non risulta tra gli indirizzi noti per %@ (controllo DNS + allowlist). Verifica che il QR sia stato emesso dal server di produzione e riprova; se il problema persiste contatta l'amministratore."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server in the QR code (%@) is not among the known addresses for %@ (DNS check + allowlist). Make sure the QR code was issued by the production server and try again; if the problem persists, contact the administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor del QR (%@) no figura entre las direcciones conocidas de %@ (comprobación DNS + allowlist). Comprueba que el QR haya sido emitido por el servidor de producción y vuelve a intentarlo; si el problema continúa, ponte en contacto con el administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur indiqué dans le QR code (%@) ne figure pas parmi les adresses connues de %@ (contrôle DNS + allowlist). Vérifie que le QR code a bien été émis par le serveur de production et réessaie ; si le problème persiste, contacte l'administrateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server im QR-Code (%@) gehört nicht zu den bekannten Adressen von %@ (DNS-Prüfung + Allowlist). Prüfen Sie, ob der QR-Code vom Produktionsserver ausgestellt wurde, und versuchen Sie es erneut; wenn das Problem weiterhin besteht, wenden Sie sich an den Administrator."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor do QR (%@) não consta entre os endereços conhecidos de %@ (verificação de DNS + allowlist). Verifique se o QR foi emitido pelo servidor de produção e tente novamente; se o problema persistir, entre em contato com o administrador."
          }
        }
      }
    },
    "contact.phonebook.partial_notice": {
      "extractionState": "manual",
      "comment": "Notice on the address-book import results when the server stopped the search part-way. %lld is how many phone numbers were not checked yet",
      "localizations": {
