          }
        }
      }
    },
    "pairing.warning.pin_mismatch": {
      "extractionState": "manual",
      "comment": "In-person pairing warning on the confirmation screen: this contact's identity key differs from the one verified before; confirm only if sure of who is in front of you",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione: la chiave di identità di questo contatto è diversa da quella verificata in precedenza. Conferma solo se sei sicuro che la persona davanti a te sia davvero questo contatto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: this contact’s identity key differs from the one verified before. Confirm only if you are sure the person in front of you really is this contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: la clave de identidad de este contacto es distinta de la verificada antes. Confirma solo si estás seguro de que la persona que tienes delante es de verdad este contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : la clé d’identité de ce contact est différente de celle vérifiée précédemment. Ne confirme que si tu es sûr que la personne en face de toi est bien ce contact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Der Identitätsschlüssel dieses Kontakts weicht von dem zuvor überprüften ab. Bestätigen Sie nur, wenn Sie sicher sind, dass die Person vor Ihnen wirklich dieser Kontakt ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção: a chave de identidade deste contato é diferente da verificada antes. Confirme só se tiver certeza de que a pessoa à sua frente é mesmo este contato."
          }
        }
      }
    },
    "pairing.warning.contact_key_mismatch": {
      "extractionState": "manual",
      "comment": "In-person pairing warning on the confirmation screen: the key presented by this phone differs from the one saved in the address book for this contact; confirm only if sure; the saved contact will not be changed",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione: la chiave che questo telefono presenta è diversa da quella salvata in rubrica per questo contatto. Conferma solo se sei sicuro che la persona davanti a te sia davvero questo contatto: la rubrica non verrà modificata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: the key this phone presents is different from the one saved in your contacts for this contact. Confirm only if you are sure the person in front of you really is this contact: your contacts will not be changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: la clave que presenta este teléfono es distinta de la guardada en tus contactos para este contacto. Confirma solo si estás seguro de que la persona que tienes delante es realmente este contacto: tus contactos no se modificarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : la clé que présente ce téléphone est différente de celle enregistrée dans tes contacts pour ce contact. Ne confirme que si tu es sûr que la personne en face de toi est bien ce contact : tes contacts ne seront pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Der Schlüssel, den dieses Telefon vorlegt, unterscheidet sich von dem für diesen Kontakt in Ihren Kontakten gespeicherten. Bestätigen Sie nur, wenn Sie sicher sind, dass die Person vor Ihnen wirklich dieser Kontakt ist: Ihre Kontakte werden nicht geändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção: a chave apresentada por este telefone é diferente da salva nos seus contatos para este contato. Confirme apenas se tiver certeza de que a pessoa à sua frente é mesmo este contato: seus contatos não serão alterados."
          }
        }
      }
    },
    "pairing.error.bluetooth_unavailable": {
      "extractionState": "manual",
      "comment": "In-person pairing error: Bluetooth is off or Q-Audion is not allowed to use it",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth non disponibile: attivalo e consenti a Q-Audion di usarlo per associare un contatto di persona."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth unavailable: turn it on and allow Q-Audion to use it to pair a contact in person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth no disponible: actívalo y permite que Q-Audion lo use para emparejar un contacto en persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth indisponible : active-le et autorise Q-Audion à l'utiliser pour associer un contact en personne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth nicht verfügbar: Schalten Sie es ein und erlauben Sie Q-Audion die Nutzung, um einen Kontakt persönlich zu koppeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth indisponível: ative-o e permita que o Q-Audion o use para parear um contato pessoalmente."
          }
        }
      }
    },
    "pairing.error.identity_unavailable": {
      "extractionState": "manual",
      "comment": "In-person pairing error: this phone has no identity yet because setup is not finished",
      "localizations": {
