    "Forza l'invio in formato 0xE3 (canonical CBOR AAD + chain ratchet) per ogni peer. Quando OFF, il routing è automatico per-peer su prima ricezione v3.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza l'invio in formato 0xE3 (canonical CBOR AAD + chain ratchet) per ogni peer. Quando OFF, il routing è automatico per-peer su prima ricezione v3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force sending in 0xE3 format (canonical CBOR AAD + chain ratchet) for every peer. When OFF, routing is automatic per-peer on first v3 receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza el envío en formato 0xE3 (canonical CBOR AAD + chain ratchet) para cada peer. Cuando está en OFF, el enrutamiento es automático por peer a partir de la primera recepción v3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force l'envoi au format 0xE3 (canonical CBOR AAD + chain ratchet) pour chaque correspondant. Quand c'est OFF, le routage est automatique par correspondant dès la première réception v3."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwingt das Senden im Format 0xE3 (canonical CBOR AAD + Chain Ratchet) für jeden Peer. Bei OFF erfolgt das Routing automatisch pro Peer beim ersten Empfang von v3."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força o envio no formato 0xE3 (canonical CBOR AAD + chain ratchet) para cada peer. Quando OFF, o roteamento é automático por peer, a partir do primeiro recebimento v3."
          }
        }
      }
    },
