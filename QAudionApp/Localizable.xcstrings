    "Ogni dispositivo linkato mantiene un keypair X25519 attestato. La revoca invalida il keypair lato server e triggera un remote wipe.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dispositivo linkato mantiene un keypair X25519 attestato. La revoca invalida il keypair lato server e triggera un remote wipe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every linked device keeps an attested X25519 keypair. Revoking it invalidates the keypair server-side and triggers a remote wipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo vinculado mantiene un keypair X25519 certificado. La revocación invalida el keypair en el servidor y activa un remote wipe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appareil associé conserve une paire de clés X25519 attestée. La révocation invalide la paire de clés côté serveur et déclenche un remote wipe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes verknüpfte Gerät verwaltet ein attestiertes X25519-Schlüsselpaar. Der Widerruf macht das Schlüsselpaar serverseitig ungültig und löst einen Remote Wipe aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo vinculado mantém um keypair X25519 atestado. A revogação invalida o keypair no servidor e dispara um remote wipe."
          }
        }
      }
    },
