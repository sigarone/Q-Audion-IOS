        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer could not be cancelled. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar la transferencia. Comprueba la conexión e inténtalo de nuevo."
          }
