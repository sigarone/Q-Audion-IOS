    "phone_transfer.info": {
      "extractionState": "manual",
      "comment": "Phone number transfer banner: what happens if the holder does nothing.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non fai nulla, alla scadenza il numero non sarà più un accesso a questo account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you do nothing, once the time is up the number will no longer be a way to sign in to this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no haces nada, al vencer el plazo el número dejará de ser un acceso a esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne fais rien, à l'expiration le numéro ne permettra plus d'accéder à ce compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie nichts tun, ist die Nummer nach Ablauf kein Zugang mehr zu diesem Konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não fizer nada, ao expirar o número deixará de ser um acesso a esta conta."
          }
        }
      }
    },
