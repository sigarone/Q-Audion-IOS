    "Su iOS gli aggiornamenti vengono distribuiti via TestFlight o App Store. Verrai reindirizzato a TestFlight per installare la build.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iOS gli aggiornamenti vengono distribuiti via TestFlight o App Store. Verrai reindirizzato a TestFlight per installare la build."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS, updates are distributed via TestFlight or the App Store. You'll be redirected to TestFlight to install the build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS, las actualizaciones se distribuyen mediante TestFlight o App Store. Serás redirigido a TestFlight para instalar la build."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iOS, les mises à jour sont distribuées via TestFlight ou l'App Store. Tu seras redirigé vers TestFlight pour installer la build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter iOS werden Updates über TestFlight oder den App Store verteilt. Sie werden zu TestFlight weitergeleitet, um den Build zu installieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iOS, as atualizações são distribuídas via TestFlight ou App Store. Você será redirecionado ao TestFlight para instalar a build."
          }
        }
      }
    },
