        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem não enviada: não é possível remover a localização e os dados do dispositivo deste formato."
          }
        }
      }
    },
    "in_call.chat.camera_blocked": {
      "extractionState": "manual",
      "comment": "Shown in the chat opened over a video call when the user taps \"take a photo\": the camera belongs to the call.",
      "localizations": {
        "it": {
