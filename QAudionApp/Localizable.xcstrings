    "in_call.voice_guard.info_body": {
      "extractionState": "manual",
      "comment": "Call screen voice check card — body of the info popup opened by tapping the card: what is compared, that it stays on the phone, and that it is a hint and not proof of identity",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta la voce dell'altra persona con l'inizio di questa chiamata. Tutto avviene su questo telefono. È un indizio, non una prova d'identità: per esserne certo usa il codice di sicurezza della chiamata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares the other person's voice with the start of this call. Everything happens on this phone. It is a hint, not proof of identity: to be sure, use the call's security code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht die Stimme der anderen Person mit dem Anfang dieses Anrufs. Alles geschieht auf diesem Telefon. Das ist ein Hinweis, kein Identitätsnachweis: Für Gewissheit verwenden Sie den Sicherheitscode des Anrufs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la voz de la otra persona con el inicio de esta llamada. Todo ocurre en este teléfono. Es un indicio, no una prueba de identidad: para estar seguro, usa el código de seguridad de la llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare la voix de l'autre personne avec le début de cet appel. Tout se passe sur ce téléphone. C'est un indice, pas une preuve d'identité : pour en être sûr, utilise le code de sécurité de l'appel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara a voz da outra pessoa com o início desta chamada. Tudo acontece neste telefone. É um indício, não uma prova de identidade: para ter certeza, use o código de segurança da chamada."
          }
        }
      }
    },
    "in_call.voice_guard.wave_a11y_overlay": {
