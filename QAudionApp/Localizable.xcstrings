          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro usuário quer habilitar capturas de tela nesta conversa. Você aprova?"
          }
        }
      }
    },
    "L'identità di questo contatto è cambiata. Verifica il nuovo safety number out-of-band prima di inviare informazioni sensibili.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identità di questo contatto è cambiata. Verifica il nuovo safety number out-of-band prima di inviare informazioni sensibili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact's identity has changed. Verify the new safety number out-of-band before sending sensitive information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad de este contacto ha cambiado. Verifica el nuevo safety number fuera de banda antes de enviar información sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identité de ce contact a changé. Vérifie le nouveau safety number hors bande avant d'envoyer des informations sensibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identität dieses Kontakts hat sich geändert. Überprüfen Sie die neue Safety Number out-of-band, bevor Sie sensible Informationen senden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade deste contato mudou. Verifique o novo safety number fora do app antes de enviar informações sensíveis."
          }
        }
      }
    },
    "L'immagine è ora nella libreria Foto.": {
      "extractionState": "manual",
