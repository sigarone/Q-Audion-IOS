    "Lascia vuoto per usare il pool di relay predefinito.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare il pool di relay predefinito."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to use the default relay pool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el pool de relay predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse vide pour utiliser le pool de relais par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Standard-Relay-Pool zu verwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o pool de relay padrão."
          }
        }
