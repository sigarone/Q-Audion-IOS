        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu annules, les nouvelles demandes de déplacement de ce numéro ne seront pas acceptées pendant 24 heures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
