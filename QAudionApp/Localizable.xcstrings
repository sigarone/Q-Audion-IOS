    "Q-Audion è riservato a chi ha almeno %lld anni. Non verifichiamo l'età: ci basiamo su quello che dichiari qui.": {
      "extractionState": "manual",
      "comment": "Registration screens, age declaration box. %lld is the minimum age (18).",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion è riservato a chi ha almeno %lld anni. Non verifichiamo l'età: ci basiamo su quello che dichiari qui."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion is for people aged %lld or over. We do not verify your age: we rely on what you declare here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion ist nur für Personen ab %lld Jahren. Wir prüfen dein Alter nicht: Wir verlassen uns auf das, was du hier angibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion está reservado a mayores de %lld años. No verificamos tu edad: nos basamos en lo que declaras aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion est réservé aux personnes âgées d'au moins %lld ans. Nous ne vérifions pas votre âge : nous nous fions à ce que vous déclarez ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion é destinado a pessoas com %lld anos ou mais. Não verificamos sua idade: confiamos no que você declara aqui."
          }
        }
      }
    },
