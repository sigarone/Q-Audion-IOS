    "Q-Audion ha bisogno della fotocamera per scansionare i QR per accoppiare contatti e collegare dispositivi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion ha bisogno della fotocamera per scansionare i QR per accoppiare contatti e collegare dispositivi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion needs the camera to scan QR codes for pairing contacts and linking devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion necesita la cámara para escanear los QR y así emparejar contactos y vincular dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion a besoin de l'appareil photo pour scanner les QR, associer des contacts et connecter des appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
