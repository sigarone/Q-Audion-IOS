    "mesh.sheet.hint_antenna_off": {
      "extractionState": "manual",
      "comment": "Bluetooth mesh sheet, hint under the antenna row: turn the antenna on to look for Q-Audion devices in Bluetooth range.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendi l'antenna per cercare dispositivi Q-Audion nel raggio del Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the antenna to look for Q-Audion devices within Bluetooth range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende la antena para buscar dispositivos Q-Audion al alcance del Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active l'antenne pour chercher des appareils Q-Audion à portée du Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Antenne ein, um nach Q-Audion-Geräten in Bluetooth-Reichweite zu suchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue a antena para procurar dispositivos Q-Audion no alcance do Bluetooth."
          }
        }
      }
    },
    "mesh.sheet.hint_visible_only": {
      "extractionState": "manual",
      "comment": "Bluetooth mesh sheet, hint under the antenna row: in visible mode others can reach this phone only while the app is open; the quoted words are the names of the Direct and Full mesh chips.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei visibile — chi ti cerca può raggiungerti, ma solo finché l'app è aperta. Passa a \"Diretta\" o \"Mesh completa\" per vedere anche tu i dispositivi vicini e restare raggiungibile in secondo piano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're visible — people looking for you can reach you, but only while the app is open. Switch to “Direct” or “Full mesh” to see nearby devices yourself and stay reachable in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres visible — quien te busca puede alcanzarte, pero solo mientras la app esté abierta. Cambia a «Directa» o «Mesh completa» para ver tú también los dispositivos cercanos y seguir siendo alcanzable en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es visible — ceux qui te cherchent peuvent te joindre, mais seulement tant que l'app est ouverte. Passe à « Directe » ou « Mesh complet » pour voir toi aussi les appareils proches et rester joignable en arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind sichtbar — wer nach Ihnen sucht, kann Sie erreichen, aber nur solange die App geöffnet ist. Wechseln Sie zu „Direkt“ oder „Vollständiges Mesh“, um auch selbst Geräte in der Nähe zu sehen und im Hintergrund erreichbar zu bleiben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está visível — quem procura por você pode se conectar, mas só enquanto o app estiver aberto. Mude para “Direta” ou “Mesh completa” para também ver os dispositivos próximos e continuar alcançável em segundo plano."
          }
        }
      }
    },
    "mesh.sheet.hint_no_devices": {
