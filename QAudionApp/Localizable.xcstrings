    "mesh_settings.subtitle": {
      "extractionState": "manual",
      "comment": "Subtitle of the Bluetooth mesh switch in Settings: the switch is the consent to relay. On, this phone relays encrypted messages of nearby app users and cannot read them.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltra via Bluetooth i messaggi cifrati di chi ti sta vicino. Non può leggerli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relays encrypted messages of people near you over Bluetooth. It cannot read them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet verschlüsselte Nachrichten von Personen in Ihrer Nähe per Bluetooth weiter. Es kann sie nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retransmite por Bluetooth los mensajes cifrados de quienes están cerca. No puede leerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaie par Bluetooth les messages chiffrés des personnes proches. Il ne peut pas les lire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retransmite por Bluetooth as mensagens criptografadas de quem está perto. Não consegue lê-las."
          }
        }
      }
    },
    "mesh_settings.status_radio_off": {
      "extractionState": "manual",
      "comment": "Subtitle of the Bluetooth mesh switch in Settings when the consent screen was answered but the antenna is off: it is turned on from the mesh panel of a chat.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesh è spenta: la accendi dal pannello mesh di una chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mesh is off: you turn it on from the mesh panel of a chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mesh ist aus: Sie schalten es im Mesh-Bereich eines Chats ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesh está apagada: la enciendes desde el panel mesh de un chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mesh est éteint : tu l'actives depuis le panneau mesh d'une discussion."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesh está desligada: você a liga pelo painel mesh de uma conversa."
          }
        }
      }
    },
    "mesh_settings.status_visible_only": {
      "extractionState": "manual",
      "comment": "Subtitle of the Bluetooth mesh switch in Settings when the antenna is on in visible-only mode: nearby phones can see this one, it opens no connections and relays nothing.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono è visibile ai vicini, ma non apre collegamenti e non inoltra messaggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is visible to people nearby, but it opens no connections and relays no messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon ist für Personen in der Nähe sichtbar, stellt aber selbst keine Verbindungen her und leitet keine Nachrichten weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono es visible para quienes están cerca, pero no abre conexiones ni retransmite mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone est visible des personnes proches, mais il n'ouvre aucune connexion et ne relaie aucun message."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone fica visível para quem está perto, mas não abre conexões nem retransmite mensagens."
          }
        }
      }
    },
    "mesh_settings.status_on": {
      "extractionState": "manual",
      "comment": "Subtitle of the Bluetooth mesh switch in Settings when the user allowed relaying and the antenna is on in full mesh mode: this phone relays encrypted messages of nearby app users.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesh è accesa: questo telefono inoltra i messaggi cifrati di chi ti sta vicino."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mesh is on: this phone relays encrypted messages of people near you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mesh ist an: Dieses Telefon leitet verschlüsselte Nachrichten von Personen in Ihrer Nähe weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesh está encendida: este teléfono retransmite los mensajes cifrados de quienes están cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mesh est activé : ce téléphone relaie les messages chiffrés des personnes proches."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesh está ligada: este telefone retransmite as mensagens criptografadas de quem está perto."
          }
        }
      }
    },
