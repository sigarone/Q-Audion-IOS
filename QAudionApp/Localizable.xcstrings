    "chat_list.group_delete_warning": {
      "extractionState": "manual",
      "comment": "Alert body confirming group chat deletion; %@ is the group name. Explains that deleting also leaves the group and cannot be undone.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" verrà rimossa da questo dispositivo insieme a tutti i suoi messaggi, e uscirai dal gruppo. L'operazione non può essere annullata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be removed from this device along with all its messages, and you will leave the group. This action cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wird zusammen mit allen Nachrichten von diesem Gerät entfernt, und Sie verlassen die Gruppe. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se eliminará de este dispositivo junto con todos sus mensajes, y saldrás del grupo. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" sera supprimé de cet appareil avec tous ses messages, et tu quitteras le groupe. Cette action ne peut pas être annulée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" será removido deste dispositivo junto com todas as suas mensagens, e você sairá do grupo. Esta ação não pode ser desfeita."
          }
        }
      }
    },
