    "Apre la chat con un contatto e mostra la conferma per condividere la posizione. Non invia nulla finché non confermi con un tocco.": {
      "extractionState": "manual",
      "comment": "Description of the Share location app intent.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la chat con un contatto e mostra la conferma per condividere la posizione. Non invia nulla finché non confermi con un tocco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the chat with a contact and shows the confirmation to share your location. Nothing is sent until you confirm with a tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el chat con un contacto y muestra la confirmación para compartir la ubicación. No se envía nada hasta que confirmes con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la conversation avec un contact et affiche la confirmation pour partager la position. Rien n’est envoyé tant que vous ne confirmez pas d’un toucher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Chat mit einem Kontakt und zeigt die Bestätigung zum Teilen des Standorts. Es wird nichts gesendet, bis du mit einem Tipp bestätigst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a conversa com um contato e mostra a confirmação para compartilhar a localização. Nada é enviado até você confirmar com um toque."
          }
        }
      }
    },
