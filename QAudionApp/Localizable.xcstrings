    "location.sheet.explainer": {
      "extractionState": "manual",
      "comment": "Explanation shown before the first live location share; %@ is the name of the contact.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è cifrata end-to-end: la vede solo %@, non il server. Puoi interrompere quando vuoi e si ferma da sola alla scadenza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location is end-to-end encrypted: only %@ can see it, not the server. You can stop whenever you want and it stops by itself when time is up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está cifrada de extremo a extremo: solo %@ puede verla, no el servidor. Puedes detenerla cuando quieras y se detiene sola al terminar el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position est chiffrée de bout en bout : elle n'est visible que par %@, pas par le serveur. Tu peux arrêter quand tu veux, et le partage s'arrête tout seul à l'échéance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist Ende-zu-Ende-verschlüsselt: Nur %@ kann ihn sehen, nicht der Server. Sie können die Freigabe jederzeit beenden; sie endet von selbst, wenn die Zeit abgelaufen ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é criptografada de ponta a ponta: só %@ pode vê-la, não o servidor. Você pode interromper quando quiser e o compartilhamento termina sozinho ao fim do tempo."
          }
        }
      }
    },
