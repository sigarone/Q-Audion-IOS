    "Tocca \\\"Conferma\\\" per richiedere l'ingresso al gruppo. L'admin del gruppo dovrà approvare la richiesta server-side.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca \\\"Conferma\\\" per richiedere l'ingresso al gruppo. L'admin del gruppo dovrà approvare la richiesta server-side."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \\\"Confirm\\\" to request to join the group. The group admin will need to approve the request server-side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca \\\"Confirmar\\\" para solicitar el ingreso al grupo. El admin del grupo deberá aprobar la solicitud en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur \\\"Confirmer\\\" pour demander à rejoindre le groupe. L'admin du groupe devra approuver la demande côté serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf \\\"Bestätigen\\\", um den Beitritt zur Gruppe zu beantragen. Der Gruppen-Admin muss die Anfrage serverseitig genehmigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \\\"Confirmar\\\" para solicitar entrada no grupo. O admin do grupo vai precisar aprovar a solicitação no servidor."
          }
        }
      }
    },
