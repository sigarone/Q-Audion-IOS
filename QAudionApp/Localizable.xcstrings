    "mesh_settings.status_direct": {
      "extractionState": "manual",
      "comment": "Subtitle of the Bluetooth mesh switch in Settings when the user did not allow relaying and the antenna is on in direct mode: this phone finds nearby contacts and exchanges the user's own messages with them, relaying nothing.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono trova i contatti vicini e scambia i tuoi messaggi con loro, senza inoltrare quelli degli altri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone finds nearby contacts and exchanges your own messages with them, without relaying anyone else's."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon findet Kontakte in der Nähe und tauscht Ihre eigenen Nachrichten mit ihnen aus, ohne die anderer weiterzuleiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono encuentra los contactos cercanos e intercambia tus mensajes con ellos, sin retransmitir los de otras personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone trouve les contacts proches et échange tes messages avec eux, sans relayer ceux des autres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone encontra os contatos próximos e troca suas mensagens com eles, sem retransmitir as de outras pessoas."
          }
        }
      }
    },
    "group_call.leave_prompt_title": {
