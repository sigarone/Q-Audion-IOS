    "phone_transfer.alert.body": {
      "extractionState": "manual",
      "comment": "Push notification body for the same request; names neither the number nor who asked.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ha chiesto di spostare il numero collegato al tuo account. Apri l'app per annullare la richiesta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone asked to move the number linked to your account. Open the app to cancel the request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien ha pedido trasladar el número vinculado a tu cuenta. Abre la app para cancelar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un a demandé de déplacer le numéro lié à ton compte. Ouvre l'app pour annuler la demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat darum gebeten, die mit Ihrem Konto verknüpfte Nummer zu übertragen. Öffnen Sie die App, um die Anfrage abzubrechen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém pediu para transferir o número vinculado à sua conta. Abra o app para cancelar a solicitação."
          }
        }
      }
    },
