    "nfc.state.waiting_peer": {
      "extractionState": "manual",
      "comment": "NFC pairing screen: the other person has not confirmed the code yet.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa dell’altra persona"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the other person"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a la otra persona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l’autre personne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf die andere Person"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a outra pessoa"
          }
        }
      }
    },
    "nfc.state.peer_rejected": {
      "extractionState": "manual",
      "comment": "NFC pairing screen: the other person did not confirm the code; nothing was saved.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altra persona ha rifiutato"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person declined"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona rechazó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre personne a refusé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person hat abgelehnt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa recusou"
          }
        }
      }
    },
    "nfc.state.hold_again_help": {
      "extractionState": "manual",
      "comment": "NFC pairing screen help: both people confirm, the phones are held together a second time.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altra persona deve confermare il codice sul suo telefono. Tieni i telefoni vicini fino alla fine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person must confirm the code on their phone. Keep the phones close until it is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona debe confirmar el código en su teléfono. Mantén los teléfonos cerca hasta el final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre personne doit confirmer le code sur son téléphone. Garde les téléphones proches jusqu’à la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person muss den Code auf ihrem Telefon bestätigen. Halten Sie die Telefone bis zum Ende nahe beieinander."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa precisa confirmar o código no telefone dela. Mantenha os telefones próximos até o fim."
          }
        }
      }
    },
    "nfc.state.waiting_peer_help": {
      "extractionState": "manual",
      "comment": "NFC pairing screen help: waiting for the other person to confirm.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altra persona deve confermare il codice sul suo telefono. Non allontanare i telefoni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other person must confirm the code on their phone. Do not move the phones apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona debe confirmar el código en su teléfono. No separes los teléfonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre personne doit confirmer le code sur son téléphone. Ne sépare pas les téléphones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die andere Person muss den Code auf ihrem Telefon bestätigen. Entfernen Sie die Telefone nicht voneinander."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa precisa confirmar o código no telefone dela. Não afaste os telefones."
          }
        }
      }
    },
    "nfc.state.idle_help": {
      "extractionState": "manual",
      "comment": "NFC pairing screen help: the iPhone reads, the Android phone must show its pairing screen in the ready state.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone funge da lettore NFC. Sul telefono Android apri l’associazione NFC di Q-Audion e premi Pronto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone acts as the NFC reader. On the Android phone, open Q-Audion NFC pairing and tap Ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone actúa como lector NFC. En el teléfono Android, abre el emparejamiento NFC de Q-Audion y pulsa Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone sert de lecteur NFC. Sur le téléphone Android, ouvre l’association NFC de Q-Audion et appuie sur Prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone arbeitet als NFC-Leser. Öffnen Sie auf dem Android-Telefon die NFC-Kopplung von Q-Audion und tippen Sie auf Bereit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone funciona como leitor NFC. No telefone Android, abra o pareamento NFC do Q-Audion e toque em Pronto."
          }
        }
      }
    },
    "nfc.state.after_confirm_hint": {
      "extractionState": "manual",
      "comment": "NFC pairing screen: confirm only when both screens show the same code; a second hold of the phones finishes the pairing.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma solo se i due schermi mostrano lo stesso codice nello stesso momento. Dopo la conferma, avvicina di nuovo l’iPhone all’altro telefono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm only if both screens show the same code at the same time. After you confirm, hold the iPhone to the other phone again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma solo si las dos pantallas muestran el mismo código al mismo tiempo. Tras confirmar, acerca de nuevo el iPhone al otro teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne confirme que si les deux écrans affichent le même code en même temps. Après la confirmation, rapproche à nouveau l’iPhone de l’autre téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie nur, wenn beide Bildschirme gleichzeitig denselben Code anzeigen. Halten Sie nach der Bestätigung das iPhone erneut an das andere Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme só se as duas telas mostrarem o mesmo código ao mesmo tempo. Depois de confirmar, aproxime o iPhone do outro telefone de novo."
          }
        }
      }
    },
