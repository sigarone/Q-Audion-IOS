    },
    "Accettando, riceverai i messaggi del gruppo e potrai inviare. Il tuo numero di telefono e l'identificativo verranno mostrati agli altri membri.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettando, riceverai i messaggi del gruppo e potrai inviare. Il tuo numero di telefono e l'identificativo verranno mostrati agli altri membri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By accepting, you'll receive the group's messages and be able to send them. Your phone number and ID will be shown to the other members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aceptas, recibirás los mensajes del grupo y podrás enviar. Tu número de teléfono y tu identificador se mostrarán a los demás miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En acceptant, tu recevras les messages du groupe et tu pourras en envoyer. Ton numéro de téléphone et ton identifiant seront visibles par les autres membres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie annehmen, erhalten Sie die Nachrichten der Gruppe und können selbst welche senden. Ihre Telefonnummer und Ihre Kennung werden den anderen Mitgliedern angezeigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao aceitar, você vai receber as mensagens do grupo e poderá enviar também. Seu número de telefone e seu identificador ficarão visíveis para os outros membros."
          }
        }
      }
    },
