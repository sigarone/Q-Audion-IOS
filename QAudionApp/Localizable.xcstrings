          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion needs the camera to scan QR codes for pairing contacts and linking devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion necesita la cámara para escanear los QR y así emparejar contactos y vincular dispositivos."
