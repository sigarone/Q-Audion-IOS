    "in_call.chat.audio_blocked": {
      "extractionState": "manual",
      "comment": "Shown in the chat opened over a call when the user tries to record or play a voice note or a video: they would take over the audio of the call.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una chiamata non si possono registrare né riprodurre note vocali e video: userebbero l'audio della chiamata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a call you cannot record or play voice notes and videos: they would use the call's audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während eines Anrufs können keine Sprachnachrichten und Videos aufgenommen oder abgespielt werden, da sie den Ton des Anrufs belegen würden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una llamada no se pueden grabar ni reproducir notas de voz y videos: usarían el audio de la llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant un appel, il est impossible d'enregistrer ou de lire des messages vocaux et des vidéos : ils utiliseraient l'audio de l'appel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante uma chamada, não é possível gravar nem reproduzir notas de voz e vídeos: eles usariam o áudio da chamada."
          }
        }
      }
    },
    "file_v2.fail.image_not_cleanable": {
      "extractionState": "manual",
      "comment": "File transfer error: the picture was not sent because its location and device data could not be removed from its format (nothing was uploaded).",
