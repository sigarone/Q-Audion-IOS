    "pairing.status.bluetooth_permission": {
      "extractionState": "manual",
      "comment": "In-person pairing: asks the user to allow Bluetooth access, needed to prove that the other phone is physically nearby",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Q-Audion di usare il Bluetooth: serve a verificare che l'altro telefono sia davvero qui."
          }
        },
        "en": {
          "stringUnit": {
