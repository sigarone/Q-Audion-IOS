    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa il microfono per le chiamate vocali cifrate post-quantistiche e per l'autenticazione vocale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses your microphone for post-quantum encrypted voice calls and voice authentication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa el micrófono para las llamadas de voz cifradas poscuánticas y para la autenticación de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le microphone pour les appels vocaux chiffrés post-quantiques et pour l'authentification vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet das Mikrofon für postquantensicher verschlüsselte Sprachanrufe und für die Sprachauthentifizierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa o microfone para chamadas de voz criptografadas pós-quânticas e para autenticação por voz."
          }
        }
      }
    },
    "NFCReaderUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion legge i tag NFC per importare in modo sicuro le chiavi di cifratura dai dispositivi Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion reads NFC tags to securely import encryption keys from Android devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion lee etiquetas NFC para importar de forma segura claves de cifrado desde dispositivos Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion lit les tags NFC pour importer en toute sécurité des clés de chiffrement depuis des appareils Android."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion liest NFC-Tags, um Verschlüsselungsschlüssel sicher von Android-Geräten zu importieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion lê tags NFC para importar com segurança chaves de criptografia de dispositivos Android."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa la fotocamera per scansionare i codici QR per lo scambio delle chiavi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses the camera to scan QR codes for key exchange."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa la cámara para escanear códigos QR para el intercambio de claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise l'appareil photo pour scanner les codes QR pour l'échange de clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet die Kamera, um QR-Codes für den Schlüsselaustausch zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa a câmera para escanear códigos QR para troca de chaves."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion può usare i tuoi contatti per permetterti di importarli nella rubrica cifrata, e per mostrare automaticamente nome e foto di un contatto telefonico quando ti chiama o lo chiami."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion can use your contacts so you can import them into your encrypted address book, and to automatically show the name and photo of a phone contact when they call you or you call them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion puede usar tus contactos para que los importes en tu agenda cifrada, y para mostrar automáticamente el nombre y la foto de un contacto telefónico cuando te llama o lo llamas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion peut utiliser tes contacts pour te permettre de les importer dans ton carnet d'adresses chiffré, et pour afficher automatiquement le nom et la photo d'un contact téléphonique quand il t'appelle ou que tu l'appelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion kann auf Ihre Kontakte zugreifen, damit Sie diese in Ihr verschlüsseltes Adressbuch importieren können, und um bei einem Anruf automatisch Name und Foto eines Telefonkontakts anzuzeigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion pode usar seus contatos para que você possa importá-los para sua agenda criptografada, e para mostrar automaticamente o nome e a foto de um contato do telefone quando ele liga para você ou você liga para ele."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion salva nella libreria Foto le immagini della chat che scegli di conservare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion saves chat images you choose to keep into your Photos library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion guarda en tu biblioteca de Fotos las imágenes del chat que elijas conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion enregistre dans ta pellicule les images de discussion que tu choisis de conserver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion speichert Chat-Bilder, die Sie behalten möchten, in Ihrer Fotomediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion salva na sua biblioteca de Fotos as imagens do chat que você escolher manter."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Face ID per sbloccare l'app quando la funzione di blocco app è attiva."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses Face ID to unlock the app when the app lock feature is enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Face ID para desbloquear la app cuando la función de bloqueo está activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise Face ID pour déverrouiller l'app quand la fonction de verrouillage est activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet Face ID, um die App zu entsperren, wenn die App-Sperre aktiviert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa o Face ID para desbloquear o app quando o recurso de bloqueio do app está ativado."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa il Bluetooth per connettersi e comunicare con la scheda P3 hardware simulator, e — solo quando attivi l'antenna mesh in una chat — per inoltrare messaggi cifrati direttamente ai dispositivi Q-Audion vicini quando non c'è connessione di rete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board, and — only when you turn on the mesh antenna in a chat — to relay encrypted messages directly with nearby Q-Audion devices when no network connection is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Bluetooth para conectarse y comunicarse con la placa P3 hardware simulator, y — solo cuando activas la antena mesh en un chat — para retransmitir mensajes cifrados directamente a dispositivos Q-Audion cercanos cuando no hay conexión de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le Bluetooth pour se connecter et communiquer avec la carte P3 hardware simulator, et — seulement quand tu actives l'antenne mesh dans une discussion — pour relayer directement des messages chiffrés vers des appareils Q-Audion à proximité quand aucune connexion réseau n'est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet Bluetooth, um sich mit der P3-Hardware-Simulator-Platine zu verbinden und mit ihr zu kommunizieren, und — nur wenn Sie die Mesh-Antenne in einem Chat aktivieren — um verschlüsselte Nachrichten direkt an nahe gelegene Q-Audion-Geräte weiterzuleiten, wenn keine Netzwerkverbindung verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa Bluetooth para se conectar e se comunicar com a placa P3 hardware simulator, e — somente quando você ativa a antena mesh em uma conversa — para retransmitir mensagens criptografadas diretamente para dispositivos Q-Audion próximos quando não há conexão de rede disponível."
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa il Bluetooth per connettersi e comunicare con la scheda P3 hardware simulator, e — solo quando attivi l'antenna mesh in una chat — per inoltrare messaggi cifrati direttamente ai dispositivi Q-Audion vicini quando non c'è connessione di rete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board, and — only when you turn on the mesh antenna in a chat — to relay encrypted messages directly with nearby Q-Audion devices when no network connection is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion usa Bluetooth para conectarse y comunicarse con la placa P3 hardware simulator, y — solo cuando activas la antena mesh en un chat — para retransmitir mensajes cifrados directamente a dispositivos Q-Audion cercanos cuando no hay conexión de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion utilise le Bluetooth pour se connecter et communiquer avec la carte P3 hardware simulator, et — seulement quand tu actives l'antenne mesh dans une discussion — pour relayer directement des messages chiffrés vers des appareils Q-Audion à proximité quand aucune connexion réseau n'est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion verwendet Bluetooth, um sich mit der P3-Hardware-Simulator-Platine zu verbinden und mit ihr zu kommunizieren, und — nur wenn Sie die Mesh-Antenne in einem Chat aktivieren — um verschlüsselte Nachrichten direkt an nahe gelegene Q-Audion-Geräte weiterzuleiten, wenn keine Netzwerkverbindung verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion usa Bluetooth para se conectar e se comunicar com a placa P3 hardware simulator, e — somente quando você ativa a antena mesh em uma conversa — para retransmitir mensagens criptografadas diretamente para dispositivos Q-Audion próximos quando não há conexão de rede disponível."
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "extractionState": "manual",
      "comment": "Info.plist usage-description string (system permission prompt)",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion condivide con Siri i nomi dei tuoi contatti per permetterti di avviare una chiamata cifrata dicendo \"Chiama [nome] su Q-Audion\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion shares your contacts' names with Siri so you can start an encrypted call by saying \"Call [name] on Q-Audion\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion comparte con Siri los nombres de tus contactos para que puedas iniciar una llamada cifrada diciendo \"Llama a [nombre] por Q-Audion\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion partage avec Siri les noms de tes contacts pour te permettre de démarrer un appel chiffré en disant « Appelle [nom] sur Q-Audion »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Q-Audion teilt die Namen Ihrer Kontakte mit Siri, damit Sie mit „Rufe [Name] auf Q-Audion an\" einen verschlüsselten Anruf starten können."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Q-Audion compartilha com a Siri os nomes dos seus contatos para você iniciar uma chamada criptografada dizendo \"Ligar para [nome] no Q-Audion\"."
          }
        }
      }
    },
