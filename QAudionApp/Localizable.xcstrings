          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To place this call you first need to leave the group call."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diesen Anruf zu tätigen, musst du zuerst den Gruppenanruf verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer esta llamada primero tienes que salir de la llamada de grupo."
          }
