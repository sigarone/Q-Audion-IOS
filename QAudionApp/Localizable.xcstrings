    "Verranno generate nuove chiavi. Tutti i contatti dovranno ri-verificare la tua identità. Continuare?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno generate nuove chiavi. Tutti i contatti dovranno ri-verificare la tua identità. Continuare?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New keys will be generated. All your contacts will need to re-verify your identity. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generarán nuevas claves. Todos tus contactos tendrán que volver a verificar tu identidad. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouvelles clés seront générées. Tous les contacts devront revérifier ton identité. Continuer ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden neue Schlüssel generiert. Alle Kontakte müssen Ihre Identität erneut verifizieren. Fortfahren?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas chaves serão geradas. Todos os contatos vão precisar reverificar sua identidade. Continuar?"
          }
        }
      }
    },
    "Verranno rimosse \\(store.entries.count) chiamate dallo storico locale. L'azione non si può annullare.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimosse \\(store.entries.count) chiamate dallo storico locale. L'azione non si può annullare."
          }
        }
      }
    },
    "Verranno rimossi numeri salvati, opt-in beta, banner dismessi, e tutto lo stato non-credenziale. La sessione di login resta attiva — usa Esci nelle Impostazioni se vuoi anche fare logout.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimossi numeri salvati, opt-in beta, banner dismessi, e tutto lo stato non-credenziale. La sessione di login resta attiva — usa Esci nelle Impostazioni se vuoi anche fare logout."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved numbers, beta opt-in, dismissed banners, and all non-credential state will be removed. The login session stays active — use Sign Out in Settings if you also want to log out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los números guardados, el opt-in de la beta, los banners descartados y todo el estado no relacionado con las credenciales. La sesión de acceso permanece activa — usa Salir en Ajustes si también quieres cerrar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros enregistrés, l'opt-in bêta, les bannières fermées et tout l'état non lié aux identifiants seront supprimés. La session de connexion reste active — utilise Se déconnecter dans les Réglages si tu veux aussi te déconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Nummern, Beta-Opt-in, geschlossene Banner und sämtlicher nicht-anmeldebezogener Status werden entfernt. Die Anmeldesitzung bleibt aktiv — nutzen Sie Abmelden in den Einstellungen, wenn Sie sich auch abmelden möchten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serão removidos os números salvos, o opt-in do beta, os banners dispensados e todo o estado não relacionado a credenciais. A sessão de login continua ativa — use Sair nos Ajustes se você também quiser fazer logout."
          }
        }
      }
    },
