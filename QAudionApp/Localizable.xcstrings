    "Il tuo voiceprint è registrato (id=%@). Da ora le chiamate saranno verificate per voce.": {
      "extractionState": "manual",
      "comment": "Text shown when voice enrollment is complete. %@ is the last 8 characters of the voiceprint identifier",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo voiceprint è registrato (id=%@). Da ora le chiamate saranno verificate per voce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voiceprint is registered (id=%@). From now on, calls will be verified by voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voiceprint está registrado (id=%@). A partir de ahora, las llamadas se verificarán por voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton voiceprint est enregistré (id=%@). Désormais, les appels seront vérifiés par la voix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Voiceprint ist registriert (id=%@). Ab jetzt werden Anrufe per Stimme verifiziert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu voiceprint foi registrado (id=%@). A partir de agora, as chamadas serão verificadas por voz."
          }
        }
      }
    },
