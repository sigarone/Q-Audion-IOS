    "Il tuo account, i contatti, le chat e le chiavi crittografiche verranno cancellati in modo permanente sia dal server che da questo dispositivo. Questa azione non può essere annullata.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account, i contatti, le chat e le chiavi crittografiche verranno cancellati in modo permanente sia dal server che da questo dispositivo. Questa azione non può essere annullata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, contacts, chats, and cryptographic keys will be permanently deleted from both the server and this device. This action can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, tus contactos, tus chats y tus claves criptográficas se eliminarán de forma permanente tanto del servidor como de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte, tes contacts, tes discussions et tes clés cryptographiques seront supprimés définitivement, à la fois du serveur et de cet appareil. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto, Ihre Kontakte, Chats und kryptografischen Schlüssel werden dauerhaft sowohl vom Server als auch von diesem Gerät gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta, seus contatos, suas conversas e suas chaves criptográficas serão apagados permanentemente, tanto do servidor quanto deste dispositivo. Essa ação não pode ser desfeita."
          }
        }
      }
    },
    "Il tuo nome sarà visibile ai tuoi contatti. Puoi cambiarlo in qualsiasi momento dalle impostazioni.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome sarà visibile ai tuoi contatti. Puoi cambiarlo in qualsiasi momento dalle impostazioni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name will be visible to your contacts. You can change it anytime from settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre será visible para tus contactos. Puedes cambiarlo en cualquier momento desde los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom sera visible par tes contacts. Tu peux le changer à tout moment depuis les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Name ist für Ihre Kontakte sichtbar. Sie können ihn jederzeit in den Einstellungen ändern."
