    "Scegli \\\"Salva in File\\\" nella schermata di condivisione per salvare il documento sul dispositivo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli \\\"Salva in File\\\" nella schermata di condivisione per salvare il documento sul dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \\\"Save to Files\\\" on the share sheet to save the document to your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige \\\"Guardar en Archivos\\\" en la pantalla de compartir para guardar el documento en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis \\\"Enregistrer dans Fichiers\\\" sur l'écran de partage pour enregistrer le document sur l'appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie \\\"In Dateien sichern\\\" im Freigabebildschirm, um das Dokument auf dem Gerät zu speichern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha \\\"Salvar em Arquivos\\\" na tela de compartilhamento para salvar o documento no dispositivo."
          }
        }
      }
    },
    "Scegli da quale paese esce il traffico VPN. \\\"Auto\\\" sceglie il nodo migliore. La scelta vale dalla prossima connessione VPN.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da quale paese esce il traffico VPN. \\\"Auto\\\" sceglie il nodo migliore. La scelta vale dalla prossima connessione VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which country the VPN traffic exits from. \\\"Auto\\\" picks the best node. The choice takes effect from the next VPN connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige desde qué país sale el tráfico VPN. \\\"Auto\\\" elige el mejor nodo. La elección se aplica a partir de la próxima conexión VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis le pays de sortie du trafic VPN. \\\"Auto\\\" sélectionne le meilleur nœud. Le choix s'applique à partir de la prochaine connexion VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, aus welchem Land der VPN-Traffic austritt. \\\"Auto\\\" wählt den besten Knoten. Die Auswahl gilt ab der nächsten VPN-Verbindung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de qual país sai o tráfego da VPN. \\\"Auto\\\" escolhe o melhor nó. A escolha vale a partir da próxima conexão de VPN."
          }
        }
      }
    },
