    "Non notificherà il server. Usa Impostazioni → Sicurezza per una richiesta di wipe se serve.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non notificherà il server. Usa Impostazioni → Sicurezza per una richiesta di wipe se serve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This won't notify the server. Use Settings → Security to request a wipe if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No notificará al servidor. Usa Ajustes → Seguridad para una solicitud de wipe si la necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne notifiera pas le serveur. Utilise Réglages → Sécurité pour une demande de wipe si besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wird nicht benachrichtigt. Nutzen Sie bei Bedarf Einstellungen → Sicherheit für eine Wipe-Anfrage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não vai notificar o servidor. Use Ajustes → Segurança para pedir um wipe se precisar."
          }
        }
      }
    },
    "Non riceverà più i messaggi del gruppo. Le chiavi vengono rigenerate per gli altri membri.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverà più i messaggi del gruppo. Le chiavi vengono rigenerate per gli altri membri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll no longer receive the group's messages. Keys are regenerated for the other members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no recibirá los mensajes del grupo. Las claves se regeneran para los demás miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne recevra plus les messages du groupe. Les clés sont régénérées pour les autres membres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhält keine Gruppennachrichten mehr. Die Schlüssel werden für die übrigen Mitglieder neu generiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não vai mais receber as mensagens do grupo. As chaves são regeneradas para os outros membros."
          }
        }
      }
    },
