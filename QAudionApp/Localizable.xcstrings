    "Inietta latenza / perdita pacchetti / offline nelle chiamate attive. Il profilo \\\"Normale\\\" ripristina il comportamento di produzione.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inietta latenza / perdita pacchetti / offline nelle chiamate attive. Il profilo \\\"Normale\\\" ripristina il comportamento di produzione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Injects latency / packet loss / offline into active calls. The \\\"Normal\\\" profile restores production behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyecta latencia / pérdida de paquetes / desconexión en las llamadas activas. El perfil \\\"Normal\\\" restaura el comportamiento de producción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Injecte de la latence / une perte de paquets / une mise hors ligne dans les appels actifs. Le profil \\\"Normal\\\" rétablit le comportement de production."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Injiziert Latenz / Paketverlust / Offline-Zustand in aktive Anrufe. Das Profil \\\"Normal\\\" stellt das Produktionsverhalten wieder her."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Injeta latência / perda de pacotes / offline nas chamadas ativas. O perfil \\\"Normal\\\" restaura o comportamento de produção."
          }
        }
      }
    },
