    "group_call.promotion_mismatch_notice": {
      "extractionState": "manual",
      "comment": "Notice after the app left a group call by itself: the group did not match what the person on the 1:1 call had proposed",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiamata di gruppo non corrispondeva a quella proposta dal tuo interlocutore: sei uscito dal gruppo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group call did not match what the person on your call proposed, so you left the group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gruppenanruf entsprach nicht dem Vorschlag deines Gesprächspartners, daher hast du die Gruppe verlassen."
          }
        },
        "es": {
