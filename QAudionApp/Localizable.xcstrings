    "Usa Associa di persona o NFC con un'altra persona, oppure aggiorna il KMS per ricevere le chiavi del server.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Associa di persona o NFC con un'altra persona, oppure aggiorna il KMS per ricevere le chiavi del server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Pair in person or NFC with another person, or refresh the KMS to receive the server's keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Emparejar en persona o NFC con otra persona, o actualiza el KMS para recibir las claves del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Associer en personne ou le NFC avec une autre personne, ou actualise le KMS pour recevoir les clés du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie „Persönlich koppeln“ oder NFC mit einer anderen Person, oder aktualisieren Sie das KMS, um die Schlüssel des Servers zu erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Parear pessoalmente ou NFC com outra pessoa, ou atualize o KMS para receber as chaves do servidor."
          }
        }
      }
    },
