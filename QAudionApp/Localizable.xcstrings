          }
        }
      }
    },
    "Non attiva. Il video usa le chiavi derivate dal telefono quando non sono disponibili chiavi sovrane.": {
      "extractionState": "manual",
      "comment": "Hint under the sovereign-only switch when it is off",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non attiva. Il video usa le chiavi derivate dal telefono quando non sono disponibili chiavi sovrane."
          }
        },
        "en": {
          "stringUnit": {
