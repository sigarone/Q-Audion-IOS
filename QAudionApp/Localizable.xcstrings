    },
    "Ti verrà assegnato un interno PBX come identificativo. Senza un numero di telefono l'email è l'unico canale per il recupero dell'account e per l'assistenza — per questo è obbligatoria.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà assegnato un interno PBX come identificativo. Senza un numero di telefono l'email è l'unico canale per il recupero dell'account e per l'assistenza — per questo è obbligatoria."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be assigned a PBX extension as your ID. Without a phone number, email is the only channel for account recovery and support — that's why it's required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te asignará una extensión PBX como identificador. Sin un número de teléfono, el email es el único canal para la recuperación de la cuenta y para la asistencia — por eso es obligatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poste PBX te sera attribué comme identifiant. Sans numéro de téléphone, l'e-mail est le seul canal pour la récupération du compte et pour l'assistance — c'est pourquoi il est obligatoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihnen wird eine PBX-Nebenstelle als Kennung zugewiesen. Ohne Telefonnummer ist die E-Mail-Adresse der einzige Kanal für die Kontowiederherstellung und den Support — deshalb ist sie erforderlich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai receber um ramal PBX como identificador. Sem um número de telefone, o e-mail é o único canal para recuperação da conta e para suporte — por isso ele é obrigatório."
          }
        }
      }
    },
