    "Il file non si può usare (formato non supportato o protetto): resta la suoneria precedente.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non si può usare (formato non supportato o protetto): resta la suoneria precedente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file cannot be used (unsupported or protected format): the previous ringtone stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar el archivo (formato no compatible o protegido): se mantiene el tono anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ne peut pas être utilisé (format non pris en charge ou protégé) : la sonnerie précédente est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei kann nicht verwendet werden (nicht unterstütztes oder geschütztes Format): Der bisherige Klingelton bleibt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pode ser usado (formato não suportado ou protegido): o toque anterior continua."
          }
        }
      }
    },
    "A telefono bloccato, se iOS non può usare il file, userà la sua suoneria di sistema.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefono bloccato, se iOS non può usare il file, userà la sua suoneria di sistema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the phone locked, if iOS cannot use the file it will use its system ringtone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el teléfono bloqueado, si iOS no puede usar el archivo, usará su tono del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le téléphone est verrouillé, si iOS ne peut pas utiliser le fichier, il utilisera sa sonnerie système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei gesperrtem Telefon verwendet iOS seinen System-Klingelton, falls es die Datei nicht nutzen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o telefone bloqueado, se o iOS não puder usar o arquivo, usará o toque do sistema."
          }
        }
      }
    },
