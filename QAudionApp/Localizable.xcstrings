    "I messaggi verranno eliminati automaticamente. \"Visualizza una volta\" li elimina appena aperti.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi verranno eliminati automaticamente. \"Visualizza una volta\" li elimina appena aperti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages will be deleted automatically. \"View once\" deletes them as soon as they are opened."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten werden automatisch gelöscht. „Einmal ansehen“ löscht sie, sobald sie geöffnet wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se eliminarán automáticamente. \"Ver una vez\" los elimina en cuanto se abren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages seront supprimés automatiquement. « Voir une seule fois » les supprime dès leur ouverture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens serão excluídas automaticamente. \"Visualizar uma vez\" as exclui assim que são abertas."
          }
        }
      }
    },
    "Il peer apre Q-Audion → Contatti → \"Aggiungi via QR\" e inquadra questo codice. Si auto-aggiungerà al gruppo dopo la verifica dell'admin.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peer apre Q-Audion → Contatti → \"Aggiungi via QR\" e inquadra questo codice. Si auto-aggiungerà al gruppo dopo la verifica dell'admin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The peer opens Q-Audion → Contacts → \"Add via QR\" and scans this code. They will add themselves to the group after the admin verifies them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Peer öffnet Q-Audion → Kontakte → „Über QR hinzufügen“ und scannt diesen Code. Er fügt sich nach der Verifizierung durch den Admin selbst zur Gruppe hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interlocutor abre Q-Audion → Contactos → \"Añadir por QR\" y escanea este código. Se añadirá automáticamente al grupo tras la verificación del admin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le correspondant ouvre Q-Audion → Contacts → « Ajouter via QR » et scanne ce code. Il s'ajoutera automatiquement au groupe après la vérification de l'admin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa abre o Q-Audion → Contatos → \"Adicionar via QR\" e escaneia este código. Ela será adicionada automaticamente ao grupo após a verificação do admin."
          }
        }
      }
    },
