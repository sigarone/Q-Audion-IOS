    "Il QR contiene solo l'ID del gruppo + il nome. Nessuna chiave crittografica passa via QR.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il QR contiene solo l'ID del gruppo + il nome. Nessuna chiave crittografica passa via QR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code contains only the group's ID + name. No cryptographic key passes through the QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El QR contiene solo el ID del grupo + el nombre. Ninguna clave criptográfica se transmite por QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le QR contient seulement l'ID du groupe + le nom. Aucune clé cryptographique ne transite via le QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code enthält nur die Gruppen-ID und den Namen. Es werden keine kryptografischen Schlüssel über den QR-Code übertragen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O QR contém apenas o ID do grupo + o nome. Nenhuma chave criptográfica passa pelo QR."
          }
        }
      }
    },
    "Il QR contiene solo la chiave pubblica X25519 e un codice monouso: nessun segreto transita.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il QR contiene solo la chiave pubblica X25519 e un codice monouso: nessun segreto transita."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code contains only the X25519 public key and a one-time code: no secret is transmitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El QR contiene solo la clave pública X25519 y un código de un solo uso: no se transmite ningún secreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le QR contient seulement la clé publique X25519 et un code à usage unique : aucun secret ne transite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code enthält nur den öffentlichen X25519-Schlüssel und einen Einmalcode: Es werden keine Geheimnisse übertragen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O QR contém apenas a chave pública X25519 e um código de uso único: nenhum segredo é transmitido."
          }
        }
      }
    },
    "Il bitrate è fisso a 32 kbps CBR su tutti i dispositivi (iOS, Android, firmware). Cambiarlo romperebbe la compatibilità cross-platform e la proprietà anti-fingerprinting (frame a dimensione costante).": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bitrate è fisso a 32 kbps CBR su tutti i dispositivi (iOS, Android, firmware). Cambiarlo romperebbe la compatibilità cross-platform e la proprietà anti-fingerprinting (frame a dimensione costante)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bitrate is fixed at 32 kbps CBR on every device (iOS, Android, firmware). Changing it would break cross-platform compatibility and the anti-fingerprinting property (constant-size frames)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bitrate es fijo en 32 kbps CBR en todos los dispositivos (iOS, Android, firmware). Cambiarlo rompería la compatibilidad multiplataforma y la propiedad anti-fingerprinting (frames de tamaño constante)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débit binaire est fixé à 32 kbps CBR sur tous les appareils (iOS, Android, firmware). Le modifier casserait la compatibilité cross-platform et la propriété anti-fingerprinting (frames de taille constante)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bitrate ist auf allen Geräten (iOS, Android, Firmware) fest auf 32 kbps CBR eingestellt. Eine Änderung würde die plattformübergreifende Kompatibilität und die Anti-Fingerprinting-Eigenschaft (Frames mit konstanter Größe) zerstören."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de bits é fixa em 32 kbps CBR em todos os dispositivos (iOS, Android, firmware). Alterá-la quebraria a compatibilidade entre plataformas e a propriedade anti-fingerprinting (frames de tamanho constante)."
          }
        }
      }
    },
    "Il contenuto del messaggio sarà visibile sulla schermata di blocco.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto del messaggio sarà visibile sulla schermata di blocco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message content will be visible on the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido del mensaje será visible en la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du message sera visible sur l'écran de verrouillage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nachrichteninhalt wird auf dem Sperrbildschirm sichtbar sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo da mensagem ficará visível na tela de bloqueio."
          }
        }
      }
    },
    "Il destinatario non potrà più leggerlo. L'azione non può essere annullata.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il destinatario non potrà più leggerlo. L'azione non può essere annullata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient will no longer be able to read it. This action can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destinatario ya no podrá leerlo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le destinataire ne pourra plus le lire. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Empfänger kann sie nicht mehr lesen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O destinatário não vai mais conseguir lê-la. Essa ação não pode ser desfeita."
          }
        }
      }
    },
    "Il mittente ha disattivato il salvataggio e la condivisione per questo allegato.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mittente ha disattivato il salvataggio e la condivisione per questo allegato."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sender has disabled saving and sharing for this attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El remitente ha desactivado el guardado y el uso compartido de este adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'expéditeur a désactivé l'enregistrement et le partage pour cette pièce jointe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Absender hat das Speichern und Teilen dieses Anhangs deaktiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remetente desativou o salvamento e o compartilhamento deste anexo."
          }
        }
      }
    },
    "Il peer apre Q-Audion → Contatti → \\\"Aggiungi via QR\\\" e inquadra questo codice. Si auto-aggiungerà al gruppo dopo la verifica dell'admin.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peer apre Q-Audion → Contatti → \\\"Aggiungi via QR\\\" e inquadra questo codice. Si auto-aggiungerà al gruppo dopo la verifica dell'admin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The peer opens Q-Audion → Contacts → \\\"Add via QR\\\" and scans this code. They'll be added to the group automatically after the admin's approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interlocutor abre Q-Audion → Contactos → \\\"Añadir por QR\\\" y enfoca este código. Se añadirá automáticamente al grupo tras la verificación del admin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le correspondant ouvre Q-Audion → Contacts → \\\"Ajouter via QR\\\" et cadre ce code. Il s'ajoutera automatiquement au groupe après vérification de l'admin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Peer öffnet Q-Audion → Kontakte → \\\"Über QR hinzufügen\\\" und scannt diesen Code. Er wird nach der Prüfung durch den Admin automatisch zur Gruppe hinzugefügt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra pessoa abre o Q-Audion → Contatos → \\\"Adicionar via QR\\\" e aponta a câmera para este código. Ela vai entrar automaticamente no grupo depois da verificação do admin."
          }
        }
      }
    },
