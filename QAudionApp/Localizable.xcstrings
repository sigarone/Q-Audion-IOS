        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen ya está en la biblioteca de Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image est maintenant dans la photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild befindet sich jetzt in der Fotomediathek."
          }
        },
        "pt-BR": {
          "stringUnit": {
