    "Tutti i messaggi e gli allegati di questa chat verranno rimossi solo da questo dispositivo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i messaggi e gli allegati di questa chat verranno rimossi solo da questo dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages and attachments in this chat will be removed only from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mensajes y adjuntos de este chat se eliminarán solo de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages et pièces jointes de cette discussion seront supprimés uniquement de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nachrichten und Anhänge dieses Chats werden nur von diesem Gerät entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as mensagens e anexos desta conversa serão removidos somente deste dispositivo."
