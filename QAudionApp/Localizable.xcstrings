    "1. Apri Q-Audion sul nuovo dispositivo.\\n2. Tocca \\\"Collega dispositivo\\\".\\n3. Inquadra il QR qui sotto con la fotocamera.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Apri Q-Audion sul nuovo dispositivo.\\n2. Tocca \\\"Collega dispositivo\\\".\\n3. Inquadra il QR qui sotto con la fotocamera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Q-Audion on the new device.\\n2. Tap \\\"Link device\\\".\\n3. Point the camera at the QR code below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre Q-Audion en el nuevo dispositivo.\\n2. Toca \\\"Vincular dispositivo\\\".\\n3. Enfoca el código QR de abajo con la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvre Q-Audion sur le nouvel appareil.\\n2. Appuie sur \\\"Associer un appareil\\\".\\n3. Cadre le QR code ci-dessous avec l'appareil photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffnen Sie Q-Audion auf dem neuen Gerät.\\n2. Tippen Sie auf \\\"Gerät verbinden\\\".\\n3. Scannen Sie den QR-Code unten mit der Kamera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abra o Q-Audion no novo dispositivo.\\n2. Toque em \\\"Vincular dispositivo\\\".\\n3. Aponte a câmera para o QR abaixo."
          }
        }
      }
    },
