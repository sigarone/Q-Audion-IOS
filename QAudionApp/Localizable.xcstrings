    "Toggle interni per il rollover dei wire-format cross-platform. Da OFF i peer iOS-iOS continuano sui formati legacy; da ON i messaggi vanno in formato compatibile con Android e Desktop.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle interni per il rollover dei wire-format cross-platform. Da OFF i peer iOS-iOS continuano sui formati legacy; da ON i messaggi vanno in formato compatibile con Android e Desktop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal toggle for the cross-platform wire-format rollover. When OFF, iOS-iOS peers keep using the legacy formats; when ON, messages go out in a format compatible with Android and Desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle interno para el rollover de los wire-format multiplataforma. En OFF, los peers iOS-iOS siguen con los formatos legacy; en ON, los mensajes van en formato compatible con Android y Desktop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupteurs internes pour le rollover des wire-formats cross-platform. En OFF, les correspondants iOS-iOS restent sur les formats legacy ; en ON, les messages passent au format compatible avec Android et Desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interner Schalter für den Rollover der plattformübergreifenden Wire-Formate. Bei OFF bleiben iOS-iOS-Peers bei den Legacy-Formaten; bei ON werden Nachrichten in einem mit Android und Desktop kompatiblen Format gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle interno para o rollover dos wire-formats entre plataformas. Com OFF, os peers iOS-iOS continuam nos formatos legacy; com ON, as mensagens vão no formato compatível com Android e Desktop."
          }
        }
      }
    },
