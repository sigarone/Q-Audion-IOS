          }
        }
      }
    },
    "Una volta revocato, il dispositivo non potrà accedere all'account. Le chiavi di sessione verranno invalidate.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta revocato, il dispositivo non potrà accedere all'account. Le chiavi di sessione verranno invalidate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once revoked, the device won't be able to access the account. Session keys will be invalidated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez revocado, el dispositivo no podrá acceder a la cuenta. Las claves de sesión quedarán invalidadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois révoqué, l'appareil ne pourra plus accéder au compte. Les clés de session seront invalidées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Widerruf kann das Gerät nicht mehr auf das Konto zugreifen. Die Sitzungsschlüssel werden ungültig gemacht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de revogado, o dispositivo não vai conseguir mais acessar a conta. As chaves de sessão serão invalidadas."
          }
        }
      }
    },
    "Uscirai dal gruppo e la chat verrà rimossa da questo dispositivo, con tutti i suoi messaggi. Per rientrare dovrai essere reinvitato da un admin.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscirai dal gruppo e la chat verrà rimossa da questo dispositivo, con tutti i suoi messaggi. Per rientrare dovrai essere reinvitato da un admin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll leave the group and the chat will be removed from this device, along with all its messages. To rejoin, you'll need to be re-invited by an admin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldrás del grupo y el chat se eliminará de este dispositivo, con todos sus mensajes. Para volver a entrar, tendrás que ser reinvitado por un admin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu quitteras le groupe et la discussion sera supprimée de cet appareil, avec tous ses messages. Pour revenir, tu devras être réinvité par un admin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verlassen die Gruppe, und der Chat wird zusammen mit allen Nachrichten von diesem Gerät entfernt. Um wieder beizutreten, müssen Sie von einem Admin erneut eingeladen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai sair do grupo e a conversa será removida deste dispositivo, com todas as suas mensagens. Para voltar, você vai precisar ser reconvidado por um admin."
          }
        }
      }
    },
