    "Scansiona il QR del tuo contatto per salvare la sua chiave pubblica nel vault. Puoi anche condividere il tuo QR qui sopra.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il QR del tuo contatto per salvare la sua chiave pubblica nel vault. Puoi anche condividere il tuo QR qui sopra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan your contact's QR code to save their public key in the vault. You can also share your own QR code above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el QR de tu contacto para guardar su clave pública en el vault. También puedes compartir tu QR de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne le QR de ton contact pour enregistrer sa clé publique dans le vault. Tu peux aussi partager ton QR ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den QR-Code Ihres Kontakts, um dessen öffentlichen Schlüssel im Vault zu speichern. Sie können auch Ihren eigenen QR-Code oben teilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o QR do seu contato para salvar a chave pública dele no vault. Você também pode compartilhar o seu QR aqui em cima."
          }
        }
      }
    },
