    "Stiamo creando il tuo voiceprint. Tieni il dispositivo fermo per qualche secondo.": {
      "extractionState": "manual",
      "comment": "Text shown while the voiceprint is being created",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo creando il tuo voiceprint. Tieni il dispositivo fermo per qualche secondo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're creating your voiceprint. Hold the device still for a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos creando tu voiceprint. Mantén el dispositivo quieto unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous créons ton voiceprint. Garde l'appareil immobile quelques secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erstellen Ihren Voiceprint. Halten Sie das Gerät einige Sekunden lang ruhig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos criando seu voiceprint. Mantenha o dispositivo parado por alguns segundos."
          }
        }
      }
    },
