<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store metadata consistency: the entire UI is hardcoded Italian
	     (no Localizable.strings/*.lproj, single-language app, not a
	     rejection cause by itself). CFBundleDevelopmentRegion should match
	     the actual shipped language. Separately, set the "Italian" primary
	     language in App Store Connect's app metadata before submission,
	     that's a dashboard setting, not derived from this key. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleDisplayName</key>
	<string>Q-Audion</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.1036</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Q-Audion uses your microphone for post-quantum encrypted voice calls and voice authentication.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Q-Audion reads NFC tags to securely import encryption keys from Android devices.</string>
	<!-- W-NFCIOS  -  the AID of the Android HCE service we tap against
	     (NfcConstants.AID_HEX, apduservice.xml). Without this array CoreNFC
	     never sends SELECT for our application, so it never surfaces an
	     NFCISO7816Tag: the reader session finds nothing and dies on its own
	     timeout. Confirmed live 2026-07-22 on an iPhone-to-S26 tap  -  the
	     Android side logged the field arriving and SELECTs going to off-host
	     (secure element) AIDs only, with zero HostEmulation dispatch to
	     com.bcrypto.qaudion.nfc.NfcApduService.

	     It belongs HERE and not in QAudion.entitlements, even though Apple
	     files its documentation page under bundleresources/entitlements. Put
	     in the entitlements file it fails the archive outright:
	       "Entitlement com.apple.developer.nfc.readersession.iso7816.select-identifiers
	        not found and could not be included in profile."
	     The sibling `readersession.formats` key IS a real entitlement and
	     stays there; only the AID list is read from Info.plist.

	     This is also NOT the restricted card-emulation entitlement. That one
	     is com.apple.developer.nfc.hce (the CardSession API, which Apple
	     documents for payments / car keys / transit / badges / hotel keys /
	     loyalty / event tickets in the EEA and requires applying for), and it
	     is why an iPhone cannot be the card  -  which bounds iPhone-to-iPhone
	     tapping, not this. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>F0BCF1073A5100</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Q-Audion uses the camera to scan QR codes for key exchange.</string>
	<key>NSContactsUsageDescription</key>
	<string>Q-Audion can use your contacts so you can import them into your encrypted address book, and to automatically show the name and photo of a phone contact when they call you or you call them.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Q-Audion saves chat images you choose to keep into your Photos library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Q-Audion uses Face ID to unlock the app when the app lock feature is enabled.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board, and — only when you turn on the mesh antenna in a chat — to relay encrypted messages directly with nearby Q-Audion devices when no network connection is available.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board, and — only when you turn on the mesh antenna in a chat — to relay encrypted messages directly with nearby Q-Audion devices when no network connection is available.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bcrypto.qaudion.ws-keepalive</string>
	</array>
	<!-- LiveKit screen-share (ReplayKit broadcast upload extension): override
	     BroadcastBundleInfo's bundle-id-derived defaults because this app's
	     bundle id (com.qaudion.app) doesn't share the "com.bcrypto.qaudion.*"
	     prefix this project's App Groups use. Both keys are read via
	     Bundle.main.infoDictionary, see client-sdk-swift
	     Sources/LiveKit/Broadcast/BroadcastBundleInfo.swift.
	     RTCAppGroupIdentifier is ALSO set (identical value) in
	     QAudionBroadcastExtension/Info.plist: each process (main app vs.
	     extension) reads its OWN Bundle.main, so the override must be present
	     on BOTH sides or the IPC socket path diverges between them. -->
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.bcrypto.qaudion.broadcast</string>
	<key>RTCScreenSharingExtension</key>
	<string>com.qaudion.app.broadcast</string>
	<!--
	  Export Compliance - required by Apple to skip the manual
	  "Provide Export Compliance Information" prompt in TestFlight.
	  Q-Audion uses ML-KEM-1024 (NIST FIPS 203, public-domain open-
	  source crypto) which qualifies as "exempt" under US BIS rules.
	  Setting `false` is appropriate for TestFlight Internal testing.
	  Revisit before App Store production submission (may need `true`
	  + ITSEncryptionExportComplianceCode or annual CCATS filing).
	  NOTE: this file is intentionally pure ASCII. A non-ASCII em-dash
	  here was repeatedly mojibaked by the release script's encoding
	  handling and ballooned Info.plist to 66 MB by v1.0.471 (W472).
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
