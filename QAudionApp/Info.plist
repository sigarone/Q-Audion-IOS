<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Q-Audion</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.740</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Q-Audion uses your microphone for post-quantum encrypted voice calls and voice authentication.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Q-Audion reads NFC tags to securely import encryption keys from Android devices.</string>
	<key>NSCameraUsageDescription</key>
	<string>Q-Audion uses the camera to scan QR codes for key exchange.</string>
	<key>NSContactsUsageDescription</key>
	<string>Q-Audion does not access your contacts. This description is required because a linked SDK references the Contacts API.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Q-Audion saves chat images you choose to keep into your Photos library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Q-Audion uses Face ID to unlock the app when the app lock feature is enabled.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Q-Audion uses Bluetooth to connect to and communicate with the P3 hardware simulator board.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bcrypto.qaudion.ws-keepalive</string>
	</array>
	<!--
	  Export Compliance - required by Apple to skip the manual
	  "Provide Export Compliance Information" prompt in TestFlight.
	  Q-Audion uses ML-KEM-1024 (NIST FIPS 203, public-domain open-
	  source crypto) which qualifies as "exempt" under US BIS rules.
	  Setting `false` is appropriate for TestFlight Internal testing.
	  Revisit before App Store production submission (may need `true`
	  + ITSEncryptionExportComplianceCode or annual CCATS filing).
	  NOTE: this file is intentionally pure ASCII. A non-ASCII em-dash
	  here was repeatedly mojibaked by the release script's encoding
	  handling and ballooned Info.plist to 66 MB by v1.0.471 (W472).
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
