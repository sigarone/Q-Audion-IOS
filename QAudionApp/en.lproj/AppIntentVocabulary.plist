<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- W-L10N-BATCH1 (2026-09-08) — English counterpart of it.lproj's
	     AppIntentVocabulary.plist (ITMS-90626 fix). Same 3 intents, same
	     "two examples per intent, app name included" shape Apple's
	     validator expects — see it.lproj's own header comment for the
	     full rationale, unchanged here. -->
	<key>IntentPhrases</key>
	<array>
		<dict>
			<key>IntentName</key>
			<string>INStartCallIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Call John on Q-Audion</string>
				<string>Call Sarah with Q-Audion</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSendMessageIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Send a message to John on Q-Audion</string>
				<string>Send a message with Q-Audion</string>
			</array>
		</dict>
		<dict>
			<key>IntentName</key>
			<string>INSearchForMessagesIntent</string>
			<key>IntentExamples</key>
			<array>
				<string>Search John's messages on Q-Audion</string>
				<string>Search messages on Q-Audion</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
