      "comment": "Spaces, parens, dashes must be stripped. Result identical to canonical form"
    },
    {
      "description": "Italian number with leading 00 (international trunk)",
      "input": "003902 1234-5678",
      "default_country": "+39",
      "normalized_e164": "+390212345678",
