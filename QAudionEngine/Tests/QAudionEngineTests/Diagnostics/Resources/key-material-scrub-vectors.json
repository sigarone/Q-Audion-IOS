   "expected": "2026-09-21T10:00:00.000Z [INFO] [stdout] derived_key [REDACTED:keybytes]\n2026-09-21T10:00:01.000Z [INFO] [call] rekey round 2 done\n2026-09-21T10:00:02.000Z [INFO] [stdout] (x.cc:118): secret [REDACTED:keybytes] len 32 slat << [] len 0\n2026-09-21T10:00:03.000Z [WARN] [stdout] secret [\n2026-09-21T10:00:04.000Z [INFO] [call] media resumed\n"
  },
  {
   "name": "lines: an unclosed secret group without content stays in its line",
   "input": "secret [\nnext line\nlast",
   "expected": "secret [\nnext line\nlast"
  },
  {
   "name": "lines: an unclosed salt parenthesis without content stays in its line",
   "input": "salt (\nfoo (bar\nlast",
   "expected": "salt (\nfoo (bar\nlast"
  },
  {
   "name": "lines: an unclosed secret group with content is cut at its line",
   "input": "secret [1,2\nnext line",
   "expected": "secret [REDACTED:keybytes]\nnext line"
  },
  {
   "name": "lines: a list cut by one line feed is a head and a tail",
   "input": "x [1,2,3,4,5,6,7,\n8] y",
   "expected": "x [REDACTED:keybytes]\n[REDACTED:keybytes] y"
  },
  {
   "name": "lines: a tail fragment on the second row",
   "input": "2026-09-21 [INFO] first\n5,17,200,] len 32\nlast",
   "expected": "2026-09-21 [INFO] first\n[REDACTED:keybytes] len 32\nlast"
  },
  {
   "name": "lines: CRLF rows keep their carriage returns",
   "input": "a\r\nsecret [1,2,3] len 3\r\nb\r\n",
   "expected": "a\r\nsecret [REDACTED:keybytes] len 3\r\nb\r\n"
  },
  {
   "name": "lines: blank rows and a trailing line feed are kept",
   "input": "\n\n[1,2,3,4,5,6,7,8]\n\n",
   "expected": "\n\n[REDACTED:keybytes]\n\n"
  },
  {
   "name": "lines: two key rows in a row",
   "input": "derived_key [1,2,3]\nsecret [4,5,6] len 3\n",
   "expected": "derived_key [REDACTED:keybytes]\nsecret [REDACTED:keybytes] len 3\n"
  },
  {
   "name": "lines: a hex run cannot span a line feed",
   "input": "aa bb cc dd\nee ff 00 11",
   "expected": "aa bb cc dd\nee ff 00 11"
  },
  {
   "name": "lines: a line feed alone",
   "input": "\n",
   "expected": "\n"
  },
  {
   "name": "lines: unicode rows around a match survive",
   "input": "héllo\nx [1,2,3,4,5,6,7,8] wörld\n🚀 ok",
   "expected": "héllo\nx [REDACTED:keybytes] wörld\n🚀 ok"
  }
 ]
}
