// Swift module for the Q-Audion crypto core's stable C ABI (qaudion-crypto-core, src/ffi.rs).
//
// This exposes the cbindgen-generated header (qaudion_crypto_core.h) to Swift as the
// `CQaudionCryptoCore` module, so `RatchetNative.swift` can `import CQaudionCryptoCore` and call
// the extern "C" qa_* surface. The same modulemap shape is what the real
// QaudionCryptoCore.xcframework ships internally (see crypto-core .github/workflows/ios.yml).
module CQaudionCryptoCore {
    header "qaudion_crypto_core.h"
    export *
}
